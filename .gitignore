node_modules/
dist/
.env
.env.*

# Присланные архивы: распаковываются в images-source и в хранилище не едут
*.zip

# Исходники съёмки — только на машине (картинки.md п. 5). Готовые картинки конвейера
# лежат в git: без них ни GitHub, ни второй человек сайт не соберут
/images-source/

# Производные файлы сборки (данные.md §8 и §12, стек-и-библиотеки.md п. 3)
/public/catalog.json
/public/api/runtime.json

# Приватная папка сервера на рабочей машине: ключи, база заказов, журнал (бэкенд.md §2)
/madera-data/
# Страницы-сущности: генерируются скриптом из данных, вручную не правятся.
# Свои страницы лежат первым уровнем (/carrito/), сгенерированные — вторым
/src/pages/*/*/

# Файлы с ключами по ошибке в корне проекта: в публичный репозиторий им нельзя (бэкенд.md §2)
/mercadopago-*.txt
/*-password*.txt

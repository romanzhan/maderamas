{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1240px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"palette": [
				{ "slug": "base", "color": "#FBF7F0", "name": "Crema" },
				{ "slug": "base-2", "color": "#F0EBE1", "name": "Arena" },
				{ "slug": "surface", "color": "#FCFAF5", "name": "Superficie" },
				{ "slug": "border", "color": "#E7DFD0", "name": "Borde" },
				{ "slug": "contrast", "color": "#2A2620", "name": "Negro cálido" },
				{ "slug": "contrast-2", "color": "#6E6355", "name": "Contraste suave" },
				{ "slug": "muted", "color": "#9A8B75", "name": "Texto atenuado" },
				{ "slug": "primary", "color": "#B4633F", "name": "Arcilla" },
				{ "slug": "primary-dark", "color": "#97482B", "name": "Arcilla oscura" },
				{ "slug": "accent", "color": "#C69C6D", "name": "Roble" },
				{ "slug": "accent-2", "color": "#5E3D28", "name": "Nogal" },
				{ "slug": "status-success", "color": "#218A4A", "name": "Éxito" },
				{ "slug": "status-success-bg", "color": "#E7F5EC", "name": "Éxito · fondo" },
				{ "slug": "promo-electric", "color": "#2F6BFF", "name": "Promo · Eléctrico" },
				{ "slug": "promo-raspberry", "color": "#E5397D", "name": "Promo · Frambuesa" },
				{ "slug": "promo-yellow", "color": "#FFC336", "name": "Promo · Amarillo" },
				{ "slug": "promo-green", "color": "#34B663", "name": "Promo · Verde" },
				{ "slug": "promo-orange", "color": "#FF6A2C", "name": "Promo · Naranja" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Texto",
					"fontFamily": "'Golos Text', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
				},
				{
					"slug": "display",
					"name": "Títulos",
					"fontFamily": "'Onest', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "S", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "M", "size": "1rem", "fluid": false },
				{ "slug": "large", "name": "L", "size": "1.125rem", "fluid": { "min": "1.0625rem", "max": "1.1875rem" } },
				{ "slug": "x-large", "name": "XL", "size": "1.375rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "xx-large", "name": "2XL", "size": "1.75rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
				{ "slug": "xxx-large", "name": "3XL", "size": "2.25rem", "fluid": { "min": "1.875rem", "max": "2.75rem" } }
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "10", "name": "1", "size": "0.5rem" },
				{ "slug": "20", "name": "2", "size": "1rem" },
				{ "slug": "30", "name": "3", "size": "1.5rem" },
				{ "slug": "40", "name": "4", "size": "2.5rem" },
				{ "slug": "50", "name": "5", "size": "4rem" },
				{ "slug": "60", "name": "6", "size": "6rem" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "soft", "name": "Suave", "shadow": "0 2px 8px rgba(46, 40, 34, 0.08)" },
				{ "slug": "lifted", "name": "Elevada", "shadow": "0 12px 32px rgba(46, 40, 34, 0.12)" },
				{ "slug": "focus", "name": "Foco", "shadow": "0 0 0 3px rgba(180, 99, 63, 0.35)" }
			]
		},
		"custom": {
			"duration": {
				"fast": "150ms",
				"base": "220ms",
				"slow": "350ms"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--30)",
			"padding": {
				"left": "var(--wp--preset--spacing--30)",
				"right": "var(--wp--preset--spacing--30)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.15"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xxx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--primary-dark)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--contrast)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				"border": { "radius": "999px" },
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.75rem",
						"right": "1.75rem"
					}
				},
				"typography": { "fontWeight": "600", "textDecoration": "none" },
				":hover": { "color": { "background": "var(--wp--preset--color--primary-dark)" } }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Encabezado", "area": "header" },
		{ "name": "footer", "title": "Pie de página", "area": "footer" }
	],
	"customTemplates": []
}

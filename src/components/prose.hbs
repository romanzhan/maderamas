{{!-- Абзацы текста из данных (данные.md §6). Разбирать текст в шаблоне нечем, поэтому
      сюда приходит готовый список абзацев из page-context — тот же приём, что у описания
      товара. Ширина колонки ограничена длиной строки (стандарты-размеров.md п. 6):
      текста во всю ширину 1440 не бывает.
      Обязательные: paragraphs. Опции: onDark (на тёмной поверхности). --}}
<div class="flex max-w-prose flex-col gap-4 {{#if onDark}}text-cream/75{{/if}}">
  {{#each paragraphs}}
    <p>{{this}}</p>
  {{/each}}
</div>

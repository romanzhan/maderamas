{{!-- Итог заказа (компоненты.md 3.10). Один компонент на панель корзины, страницу
      корзины и чекаут; суммы — только через формат цены.
      Доставку сайт не считает и не берёт (решение владельца 09.09.2026): её стоимость
      в цену не входит и согласуется с покупателем после покупки, поэтому строка так и
      говорит — «no incluido» — и в корзине, и на чекауте. Появится ставка в настройках —
      строка покажет сумму. Опция: shipping — ставка доставки из настроек. --}}
<div class="flex flex-col gap-1">
  <div class="flex items-baseline justify-between gap-4">
    <span class="text-small text-charcoal/70">{{t "cart.subtotal"}}</span>
    {{> price empty compact=true value=0 bind="fmt(subtotal)"}}
  </div>

  <div class="flex items-baseline justify-between gap-4">
    <span class="text-small text-charcoal/70">{{t "cart.shipping"}}</span>
    {{#if shipping}}
      <span class="text-small tabular-nums">{{money shipping}}</span>
    {{else}}
      <span class="text-small text-charcoal/70">{{t "cart.shippingNotIncluded"}}</span>
    {{/if}}
  </div>

  <div class="mt-1 flex items-baseline justify-between gap-4 border-t border-line pt-2">
    <span class="text-body font-medium">{{t "cart.total"}}</span>
    {{> price empty value=0 bind="fmt(total)"}}
  </div>
</div>

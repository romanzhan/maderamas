{{!-- Разделы длинного текста (данные.md §4): H2 → абзацы → список → вынесенная фраза →
      врезка. Общие для статьи блога и игры раздела Para familias — контракт один,
      разметка одна. Порядок внутри раздела закреплён: разнообразие даёт не
      перестановка, а то, что у каждого раздела свой набор: где-то только текст, где-то
      шаги списком. Свободный порядок потребовал бы описывать в данных ещё и раскладку.
      Обязательные: sections (готовые, из page-context: абзацы разобраны). --}}
{{#each sections}}
  <section id="{{id}}" class="mt-10 flex flex-col gap-4 lg:mt-12">
    <h2 class="max-w-prose font-display text-h2 lg:text-h2-lg">{{title}}</h2>

    {{> prose @root.empty paragraphs=body}}

    {{#if items.length}}
      {{#if ordered}}
        <ol class="rich-text flex max-w-prose list-decimal flex-col gap-2 pl-5
          marker:font-medium marker:text-clay">
          {{#each items}}<li>{{{this}}}</li>{{/each}}
        </ol>
      {{else}}
        <ul class="rich-text flex max-w-prose list-disc flex-col gap-2 pl-5
          marker:text-clay">
          {{#each items}}<li>{{{this}}}</li>{{/each}}
        </ul>
      {{/if}}
    {{/if}}

    {{#if quote}}
      {{!-- Вынесенная фраза — не цитата чужих слов, поэтому это абзац
            с полосой, а не blockquote (seo.md п. 1: вид не задаёт смысл) --}}
      <p class="rich-text mt-2 max-w-prose border-l-2 border-clay pl-4 font-display
        text-h4 lg:text-h4-lg">{{{quote}}}</p>
    {{/if}}

    {{#if note}}
      <div class="rich-text mt-2 max-w-prose rounded-2xl bg-sand p-5 lg:p-6">
        {{#if note.title}}
          <p class="font-medium">{{note.title}}</p>
        {{/if}}
        <p class="{{#if note.title}}mt-2 {{/if}}text-charcoal/70">{{{note.text}}}</p>
      </div>
    {{/if}}
  </section>
{{/each}}

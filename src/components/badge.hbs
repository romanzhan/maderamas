{{!-- Бейдж (компоненты.md 3.3). Виды: discount (скидка — малиновый) · isNew (Nuevo —
      синий) · status (Sin stock — тёмный) · info (envío gratis — зелёный).
      Цвета закреплены за смыслом, а не выбираются по месту: цвет текста на каждом
      промо-фоне задан в визуальная-система.md §2.2.
      Больше двух бейджей на карточке не вешаем: приоритет скидка → статус → инфо.
      bindKind — вид из выражения Alpine (список заказов владельца: состояние приходит
      с сервера): success · warning · error · neutral · status — тона состояний
      из визуальная-система.md, а не промо; bindText — подпись оттуда же. --}}
<span
  class="inline-flex h-6 items-center rounded-sm px-2 text-caption whitespace-nowrap
    {{#if discount}}bg-promo-pink text-cream{{/if}}
    {{#if isNew}}bg-promo-blue text-cream{{/if}}
    {{#if status}}bg-charcoal text-cream{{/if}}
    {{#if info}}bg-promo-green text-cream{{/if}}"
  {{#if bindKind}}
    x-bind:class="{
      'bg-success-bg text-success': ({{bindKind}}) === 'success',
      'bg-warning-bg text-warning': ({{bindKind}}) === 'warning',
      'bg-error-bg text-error': ({{bindKind}}) === 'error',
      'bg-sand text-charcoal/70': ({{bindKind}}) === 'neutral',
      'bg-charcoal text-cream': ({{bindKind}}) === 'status',
    }"
  {{/if}}
  {{#if bindText}}x-text="{{bindText}}"{{/if}}
>{{#if text}}{{text}}{{else}}{{#if label}}{{t label}}{{/if}}{{/if}}</span>

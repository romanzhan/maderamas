{{!-- «Как это работает» (страницы.md §14а). Отдельная страница, а не якорь на главной
      (решение владельца 28.08.2026): вопрос «как это вообще устроено» задают до выбора
      модели, и ответ на него не должен тонуть в середине главной.
      Фактов не выдумываем: медведи, возрасты и материал взяты из карточки флагмана,
      вопросы — из общего списка FAQ, пункты безопасности — из словаря. --}}
<main id="contenido" class="pt-6 pb-16 lg:py-10">
  <div class="page-container">
    {{> breadcrumbs empty items=breadcrumbs.items plain=breadcrumbs.plain}}

    <h1 class="mt-4 max-w-prose font-display text-h1 lg:text-h1-lg">
      {{t "howItWorks.title"}}
    </h1>
    <p class="mt-4 max-w-prose text-lead text-charcoal/70">{{t "howItWorks.lead"}}</p>
  </div>

  {{!-- Регулировка: слева объяснение, справа кадры инфографики (их готовит владелец) --}}
  <section class="page-container mt-12 lg:mt-16">
    <div class="grid items-start gap-8 lg:grid-cols-2 lg:gap-12">
      <div class="flex flex-col gap-6">
        <div>
          <h2 class="font-display text-h2 lg:text-h2-lg">{{t "howItWorks.adjustTitle"}}</h2>
          <p class="mt-3 max-w-prose text-charcoal/70">{{t "howItWorks.adjustLead"}}</p>
        </div>

        <ul class="flex flex-col gap-6">
          <li>
            {{> feature-item empty inline=true icon="move-vertical" title="howItWorks.adjustSeat"
                text="howItWorks.adjustSeatText"}}
          </li>
          <li>
            {{> feature-item empty inline=true icon="accessibility" title="howItWorks.adjustFeet"
                text="howItWorks.adjustFeetText"}}
          </li>
          <li>
            {{> feature-item empty inline=true icon="ruler" title="howItWorks.adjustDepth"
                text="howItWorks.adjustDepthText"}}
          </li>
        </ul>
      </div>

      <div class="min-w-0">
        {{> frame-carousel empty frames=home.adjustFrames alt=(t "howItWorks.frameAlt")
            sizes="(min-width: 1024px) 50vw, 100vw"}}
      </div>
    </div>
  </section>

  {{!-- Кадр-передышка: фотографию владелец подберёт, до неё стоит заглушка --}}
  <section class="mt-12 lg:mt-16">
    {{> picture empty id="como-funciona-foto" alt=(t "howItWorks.title")
        ratio="aspect-video sm:aspect-panorama" sizes="100vw"
        class="aspect-video w-full object-cover sm:aspect-panorama"}}
  </section>

  {{!-- Медведи и возрасты: числа взяты у флагмана, а не набраны заново --}}
  <section class="page-container mt-12 lg:mt-16">
    <h2 class="font-display text-h2 lg:text-h2-lg">{{t "howItWorks.sizeTitle"}}</h2>
    <p class="mt-3 max-w-prose text-charcoal/70">{{t "howItWorks.sizeLead"}}</p>

    <div class="mt-6 grid gap-8 lg:grid-cols-2 lg:gap-12">
      <dl class="flex flex-col">
        {{#each how.specs}}
          <div
            class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1
              border-b border-line py-3"
          >
            <dt class="text-small text-charcoal/70">{{t label}}</dt>
            <dd class="text-body">{{value}}</dd>
          </div>
        {{/each}}
      </dl>

      {{#if how.dimensionsImage}}
        <div class="overflow-hidden rounded-xl bg-sand">
          {{> picture empty id=how.dimensionsImage alt=(t "howItWorks.sizeTitle")
              sizes="(min-width: 1024px) 50vw, 100vw"
              class="aspect-square w-full object-contain"}}
        </div>
      {{/if}}
    </div>
  </section>

  {{!-- Из чего сделана: те же пункты безопасности, что на странице товара --}}
  <section class="page-container mt-12 lg:mt-16">
    <h2 class="font-display text-h2 lg:text-h2-lg">{{t "howItWorks.materialTitle"}}</h2>
    <p class="mt-3 max-w-prose text-charcoal/70">{{t "howItWorks.materialLead"}}</p>

    <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {{#each how.safety}}
        <li>
          {{> feature-item ../empty icon=icon
              title=(concat "product.safety" key "")
              text=(concat "product.safety" key "Text")}}
        </li>
      {{/each}}
    </ul>
  </section>

  {{!-- Сборка и доставка: то же, что написано в карточке товара, без новых обещаний --}}
  <section class="mt-12 lg:mt-16">
    <div class="page-container">
      <div class="rounded-2xl bg-sand p-6 lg:p-10">
        <h2 class="font-display text-h3 lg:text-h3-lg">{{t "howItWorks.assemblyTitle"}}</h2>
        <p class="mt-3 max-w-prose text-charcoal/70">{{t "howItWorks.assemblyText"}}</p>
      </div>
    </div>
  </section>

  {{#if home.faq.length}}
    <section class="page-container mt-12 lg:mt-16">
      <div class="grid gap-6 lg:grid-cols-3 lg:gap-12">
        <h2 class="font-display text-h2 lg:text-h2-lg">{{t "howItWorks.faqTitle"}}</h2>
        <div class="lg:col-span-2">
          {{#each home.faq}}
            {{> accordion-item ../empty id=(concat "how-" id) question=question
                answer=answer}}
          {{/each}}
        </div>
      </div>
    </section>
  {{/if}}

  <section class="page-container mt-12 flex justify-center lg:mt-16">
    {{> button empty primary=true sizeLg=true label="howItWorks.cta" href=nav.catalogHref}}
  </section>
</main>

{{!-- Para familias: список игр и занятий (страницы.md §14б). Плитки в промо-тонах —
      тон это содержание ряда, как у плиток подбора на главной (визуальная-система.md
      §2.3). Сетка, а не лента: игр немного, и все должны быть видны сразу.
      Игр нет — пустое состояние с выходом в блог или каталог (компоненты.md 6.3). --}}
<main id="contenido" class="page-container py-6 lg:py-10">
  {{> breadcrumbs empty items=breadcrumbs.items plain=breadcrumbs.plain}}

  <div class="mt-4 flex flex-col gap-4">
    <h1 class="max-w-prose font-display text-h1 lg:text-h1-lg">{{t "families.title"}}</h1>
    <p class="max-w-prose text-lead text-charcoal/70">{{t "families.lead"}}</p>
  </div>

  {{#if families.activities.length}}
    {{!-- Заголовок сетки для скринридера: заголовок плитки — H3 (seo.md п. 1) --}}
    <h2 class="sr-only">{{t "families.gridTitle"}}</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:mt-12 lg:grid-cols-3 lg:gap-6">
      {{#each families.activities}}
        {{> tile ../empty href=href title=name text=excerpt icon=icon meta=meta
            accent=accent}}
      {{/each}}
    </div>
  {{else}}
    <div class="mt-12 text-center">
      <span class="inline-flex text-charcoal/45">
        {{> icon empty name="puzzle" class="size-10"}}
      </span>
      <p class="mt-3 text-lead">{{t "families.empty"}}</p>
      <div class="mt-4 flex justify-center">
        {{> button empty primary=true sizeMd=true label="home.viewAllFem" href=nav.catalogHref}}
      </div>
    </div>
  {{/if}}

  {{> families/share}}

  {{#if site.features.blog}}
    <section class="mt-12 flex flex-col items-start gap-4 lg:mt-16">
      <h2 class="font-display text-h3 lg:text-h3-lg">{{t "families.blogTitle"}}</h2>
      <p class="max-w-prose text-charcoal/70">{{t "families.blogText"}}</p>
      {{> link empty href="/blog/" label="families.blogCta" viewAll=true}}
    </section>
  {{/if}}
</main>

{{!-- Игра раздела Para familias (страницы.md §14б): значок в тоне игры → H1 и лид →
      строка «возраст · длительность · формат» → вводные абзацы → сама игра (на экране
      или лист для печати) → как играть → разделы-советы → приглашение в Instagram →
      товары к игре → другие игры.
      Блоки — прямые дети <main>: при печати страницы с листом (data-print-sheet)
      остаётся только он (main.css, правило печати), и это правило обязано их видеть.
      Значок, а не обложка: своих снимков у игр нет, а заглушка бренда на месте кадра
      читалась бы браком (состояния-экранов.md п. 9). --}}
<main id="contenido" class="pb-16">
  <div class="page-container pt-6 lg:pt-10">
    {{> breadcrumbs empty items=breadcrumbs.items plain=breadcrumbs.plain}}
  </div>

  <header class="page-container mt-6 lg:mt-10">
    <span class="flex size-14 items-center justify-center rounded-2xl {{activity.accent}}">
      {{> icon empty name=activity.icon class="size-6"}}
    </span>
    <h1 class="mt-4 max-w-prose font-display text-h1 text-balance lg:text-h1-lg">{{activity.title}}</h1>
    <p class="mt-3 max-w-prose text-lead text-charcoal/70">{{activity.excerpt}}</p>

    <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
      <div class="flex flex-col gap-1">
        <dt class="text-small text-charcoal/70">{{t "families.agesLabel"}}</dt>
        <dd class="font-medium">{{activity.ages}}</dd>
      </div>
      <div class="flex flex-col gap-1">
        <dt class="text-small text-charcoal/70">{{t "families.durationLabel"}}</dt>
        <dd class="font-medium">{{activity.duration}}</dd>
      </div>
      <div class="flex flex-col gap-1">
        <dt class="text-small text-charcoal/70">{{t "families.formatLabel"}}</dt>
        <dd class="font-medium">{{activity.formatLabel}}</dd>
      </div>
    </dl>

    <div class="mt-8">
      {{> prose empty paragraphs=activity.body}}
    </div>
  </header>

  {{#if activity.memotest}}{{> families/memotest}}{{/if}}
  {{#if activity.shapes}}{{> families/shapes}}{{/if}}
  {{#if activity.treasure}}{{> families/treasure}}{{/if}}
  {{#if activity.chart}}{{> families/chart}}{{/if}}
  {{#if activity.recipes}}{{> families/recipes}}{{/if}}
  {{#if activity.coloring}}{{> families/coloring}}{{/if}}

  <section class="page-container mt-10 lg:mt-12">
    <h2 class="max-w-prose font-display text-h2 lg:text-h2-lg">{{t "families.howTo"}}</h2>
    <ol class="rich-text mt-4 flex max-w-prose list-decimal flex-col gap-2 pl-5
      marker:font-medium marker:text-clay">
      {{#each activity.steps}}<li>{{{this}}}</li>{{/each}}
    </ol>

    {{#if activity.materials.length}}
      <h2 class="mt-10 max-w-prose font-display text-h2 lg:mt-12 lg:text-h2-lg">{{t "families.materials"}}</h2>
      <ul class="rich-text mt-4 flex max-w-prose list-disc flex-col gap-2 pl-5 marker:text-clay">
        {{#each activity.materials}}<li>{{{this}}}</li>{{/each}}
      </ul>
    {{/if}}
  </section>

  {{#if activity.sections.length}}
    <div class="page-container">
      {{> article-sections empty sections=activity.sections}}
    </div>
  {{/if}}

  <div class="page-container">
    {{> families/share}}
  </div>

  {{#if activity.related.length}}
    <section class="page-container mt-12 lg:mt-16">
      <h2 class="font-display text-h2 lg:text-h2-lg">{{t "families.relatedTitle"}}</h2>
      <div class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 lg:mt-8 lg:grid-cols-4 lg:gap-6">
        {{#each activity.related}}
          {{> product-card ../empty id=id name=name price=price old=old discount=discount priceFrom=priceFrom
              hasOptions=hasOptions href=href inStock=inStock isNew=isNew rating=rating
              reviewsCount=reviewsCount imageId=imageId imageIdHover=imageIdHover}}
        {{/each}}
      </div>
    </section>
  {{/if}}

  {{#if activity.more.length}}
    <section class="page-container mt-12 lg:mt-16">
      <h2 class="font-display text-h2 lg:text-h2-lg">{{t "families.moreTitle"}}</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:mt-8 lg:grid-cols-3 lg:gap-6">
        {{#each activity.more}}
          {{> tile ../empty href=href title=name text=excerpt icon=icon meta=meta
              accent=accent}}
        {{/each}}
      </div>
    </section>
  {{/if}}

  <div class="page-container mt-12 lg:mt-16">
    {{> link empty nav=true href="/para-familias/" label="families.backToList"}}
  </div>
</main>

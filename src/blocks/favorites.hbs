{{!-- Избранное (страницы.md §5). Карточки отрисованы все и сразу, а показываются только
      отмеченные — тот же приём, что у фильтров каталога: список маленький, а браузеру
      не приходится собирать карточку второй раз, своей разметкой, в обход компонента.
      Отсюда же берётся состояние «товар без наличия» — карточка остаётся с бейджем.
      А вот «пусто или нет» по счётчику store считать нельзя: там лежат сырые записи
      localStorage, и товар, снятый с продажи, оставлял бы пустую сетку без выхода
      со страницы (поймано ревью 28.08.2026). Поэтому считаются только те отметки,
      которым на странице есть что показать.
      Флаг wishlist выключен — страницы не существует (состояния-экранов.md п. 5). --}}
{{#if site.features.wishlist}}
  <main
    id="contenido"
    class="page-container py-6 lg:py-10"
    x-data="favoritesView()"
    data-ids="{{#each cards}}{{id}} {{/each}}"
  >
    {{> breadcrumbs empty items=breadcrumbs.items plain=breadcrumbs.plain}}

    <h1 class="mt-4 font-display text-h1 lg:text-h1-lg">{{t "wishlist.title"}}</h1>

    {{!-- Заголовок сетки для скринридера — см. каталог: иначе H1 → H3 --}}
    <h2 class="sr-only" x-show="shown > 0">{{t "catalog.gridTitle"}}</h2>
    <div
      x-show="shown > 0"
      x-cloak
      class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 lg:mt-8 lg:grid-cols-3 lg:gap-6 xl:grid-cols-4"
    >
      {{#each cards}}
        <div x-show="$store.wishlist.has('{{id}}')" x-cloak>
          {{> product-card ../empty id=id name=name price=price old=old discount=discount priceFrom=priceFrom
              hasOptions=hasOptions href=href inStock=inStock isNew=isNew rating=rating
              reviewsCount=reviewsCount imageId=imageId imageIdHover=imageIdHover
              freeShipping=freeShipping}}
        </div>
      {{/each}}
    </div>

    {{!-- Пусто — не тупик: витринное пустое состояние с выходом (компоненты.md 6.3) --}}
    <div x-show="shown === 0" x-cloak class="mt-12 text-center">
      <span class="inline-flex text-charcoal/45">
        {{> icon empty name="heart" class="size-10"}}
      </span>
      <p class="mt-3 text-lead">{{t "wishlist.empty"}}</p>
      <div class="mt-4 flex justify-center">
        {{> button empty primary=true sizeMd=true label="wishlist.emptyCta"
            href=nav.catalogHref}}
      </div>
    </div>
  </main>
{{else}}
  {{> not-found}}
{{/if}}

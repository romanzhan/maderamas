{{!-- Список статей (страницы.md §14). Сетка, а не лента: на главной статьи листаются
      вбок рядом с товарами, а здесь весь раздел и есть содержимое страницы.
      Статей нет — пустое состояние с выходом в каталог (состояния-экранов.md п. 9).
      Флаг blog выключен — раздела не существует, и вместо списка показывается 404:
      тот же приём, что на странице избранного. --}}
{{#if site.features.blog}}
<main id="contenido" class="page-container py-6 lg:py-10">
  {{> breadcrumbs empty items=breadcrumbs.items plain=breadcrumbs.plain}}

  <div class="mt-4 flex flex-col gap-4">
    <h1 class="max-w-prose font-display text-h1 lg:text-h1-lg">{{t "blog.title"}}</h1>
    <p class="max-w-prose text-lead text-charcoal/70">{{t "blog.lead"}}</p>
  </div>

  {{#if blog.articles.length}}
    {{!-- Заголовок сетки для скринридера: заголовок статьи в карточке — H3, и без
          H2 иерархия прыгала бы через уровень (seo.md п. 1) --}}
    <h2 class="sr-only">{{t "blog.gridTitle"}}</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:mt-12 lg:grid-cols-3 lg:gap-8">
      {{#each blog.articles}}
        {{> article-card ../empty article=this}}
      {{/each}}
    </div>
  {{else}}
    {{!-- Тупик без кнопки запрещён (компоненты.md 6.3) --}}
    <div class="mt-12 text-center">
      <span class="inline-flex text-charcoal/45">
        {{> icon empty name="image" class="size-10"}}
      </span>
      <p class="mt-3 text-lead">{{t "blog.empty"}}</p>
      <div class="mt-4 flex justify-center">
        {{> button empty primary=true sizeMd=true label="home.viewAllFem" href=nav.catalogHref}}
      </div>
    </div>
  {{/if}}

  {{> help-cta}}
</main>
{{else}}
  {{> not-found}}
{{/if}}

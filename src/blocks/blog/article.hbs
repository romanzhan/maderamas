{{!-- Статья блога (страницы.md §14): обложка → заголовок → дата → текст в узкой колонке →
      блок в каталог → товары из подборки автора → соседние статьи.
      Блок в каталог стоит всегда, даже когда товаров у статьи нет: иначе статья
      становится тупиком. Обложки нет — кадра нет вовсе, а не заглушка: у статьи
      картинка не смысловая, и пустой прямоугольник читался бы браком
      (состояния-экранов.md п. 9). --}}
<main id="contenido" class="pb-16">
  <div class="page-container pt-6 lg:pt-10">
    {{> breadcrumbs empty items=breadcrumbs.items plain=breadcrumbs.plain}}
  </div>

  {{!-- Обложка квадратная, как все фотографии проекта, и потому стоит в колонке текста,
        а не во всю ширину: квадрат во весь экран занял бы его целиком --}}
  {{#if article.cover}}
    <div class="page-container mt-6 lg:mt-8">
      <div class="max-w-prose overflow-hidden rounded-2xl">
        {{> picture empty id=article.cover alt=article.title
            sizes="(min-width: 40rem) 640px, 100vw"
            class="aspect-square w-full object-cover"}}
      </div>
    </div>
  {{/if}}

  <article class="page-container mt-8 lg:mt-12">
    <h1 class="max-w-prose font-display text-h1 lg:text-h1-lg">{{article.title}}</h1>

    <p class="mt-3 text-small text-charcoal/70">
      <time datetime="{{article.date}}">{{dateLong article.date}}</time>
    </p>

    <p class="mt-6 max-w-prose text-lead text-charcoal/70">{{article.excerpt}}</p>

    <div class="mt-6">
      {{> prose empty paragraphs=article.body}}
    </div>
  </article>

  {{!-- Выход в каталог: он стоит здесь всегда, а не «если есть товары» --}}
  <section class="page-container mt-12 lg:mt-16">
    <div class="flex flex-col items-start gap-4 rounded-2xl bg-sand p-6 lg:p-10">
      <h2 class="font-display text-h3 lg:text-h3-lg">{{t "article.cta"}}</h2>
      <p class="max-w-prose text-charcoal/70">{{t "blog.ctaText"}}</p>
      {{> button empty primary=true sizeMd=true label="home.heroCta" href=nav.catalogHref}}
    </div>
  </section>

  {{#if article.related.length}}
    <section class="page-container mt-12 lg:mt-16">
      <h2 class="font-display text-h2 lg:text-h2-lg">{{t "product.related"}}</h2>
      <div class="mt-6 grid grid-cols-2 gap-3 sm:gap-4 lg:mt-8 lg:grid-cols-4 lg:gap-6">
        {{#each article.related}}
          {{> product-card ../empty id=id name=name price=price old=old discount=discount priceFrom=priceFrom
              hasOptions=hasOptions href=href inStock=inStock isNew=isNew rating=rating
              reviewsCount=reviewsCount imageId=imageId imageIdHover=imageIdHover freeShipping=freeShipping}}
        {{/each}}
      </div>
    </section>
  {{/if}}

  {{#if article.more.length}}
    <section class="page-container mt-12 lg:mt-16">
      <h2 class="font-display text-h2 lg:text-h2-lg">{{t "blog.moreTitle"}}</h2>
      <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:mt-8 lg:grid-cols-3 lg:gap-8">
        {{#each article.more}}
          {{> article-card ../empty article=this}}
        {{/each}}
      </div>
    </section>
  {{/if}}

  <div class="page-container mt-12 lg:mt-16">
    {{> link empty nav=true href="/blog/" label="blog.backToList"}}
  </div>
</main>

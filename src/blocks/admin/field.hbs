{{!-- Одно поле редактора контента по описанию из data/admin-schema.json (бэкенд.md §15).
      Параметры — имена переменных Alpine, а не значения: m — запись, которую правим
      (c.item, c.doc.data, c.docs.site.data или строка вложенного списка row), f — описание
      поля. nested — поле внутри строки вложенного списка: вложенных списков там не бывает,
      поэтому и повторного включения самого себя глубже одного уровня нет.
      Подпись оборачивает поле — связь подписи и ввода без id, которых у полей,
      повторяющихся в строках списка, не бывает. Заголовков групп здесь нет: поля
      раскладывает по карточкам content.hbs (adminContent.groups).
      when/unless в схеме — поле видно только при таком значении другого поля записи. --}}
<div class="flex flex-col gap-2" x-show="c.visible({{m}}, {{f}})">
  {{!-- Строка, адрес, деньги. Поля браузерного типа (number, date) здесь не живут:
        их стрелки и календарь браузер рисует сам и по-своему — ниже свои --}}
  <template x-if="['text', 'slug', 'money'].includes({{f}}.type)">
    <label class="flex flex-col gap-2">
      <span class="text-small font-medium">
        <span x-text="{{f}}.label"></span><span x-show="{{f}}.required" class="text-error" aria-hidden="true"> *</span>
      </span>
      <input
        type="text"
        x-bind:inputmode="{{f}}.type === 'money' ? 'numeric' : null"
        x-bind:value="c.value({{m}}, {{f}})"
        x-on:input="{{f}}.type === 'text' && c.update({{m}}, {{f}}, $event.target.value)"
        x-on:change="c.update({{m}}, {{f}}, $event.target.value) === false && ($event.target.value = c.value({{m}}, {{f}}))"
        x-bind:class="{{f}}.type === 'money' ? 'w-full sm:max-w-xs tabular-nums' : 'w-full'"
        class="{{> field-box}} px-4"
      />
      <span x-show="{{f}}.type === 'money' && c.value({{m}}, {{f}}) !== ''" class="text-small text-charcoal/70 tabular-nums" x-text="c.money(c.value({{m}}, {{f}}))"></span>
    </label>
  </template>

  {{!-- Число: «− значение +», как счётчик количества в магазине. Кнопки — шаг на
        единицу, дробное (вес 7,9) вписывается руками. Меньше нуля в наших полях
        ничего не бывает: «−» у нуля просто стоит на месте, а не гаснет — погасшая кнопка
        выбросила бы фокус клавиатуры в начало страницы --}}
  <template x-if="{{f}}.type === 'number'">
    <div class="flex flex-col gap-2">
      {{!-- Подпись — текстом, а не label: внутри три элемента, и нажатие по подписи
            попадало бы в кнопку «−». Полю ввода имя даёт aria-label --}}
      <span class="text-small font-medium" aria-hidden="true">
        <span x-text="{{f}}.label"></span><span x-show="{{f}}.required" class="text-error"> *</span>
      </span>
      <span class="flex w-fit items-center rounded-md border border-border bg-sand focus-within:border-clay">
        <button
          type="button"
          x-on:click="c.step({{m}}, {{f}}, -1)"
          class="flex size-12 shrink-0 items-center justify-center rounded-l-md hover:bg-sand-hover lg:size-11"
          x-bind:aria-label="'{{t "admin.less"}}: ' + {{f}}.label"
        >{{> icon empty name="minus" class="size-5"}}</button>
        <input
          type="text"
          inputmode="decimal"
          x-bind:aria-label="{{f}}.label"
          x-bind:value="c.value({{m}}, {{f}})"
          x-bind:aria-required="{{f}}.required ? 'true' : null"
          x-on:change="c.update({{m}}, {{f}}, $event.target.value) === false && ($event.target.value = c.value({{m}}, {{f}}))"
          class="h-12 w-24 border-x border-border bg-sand text-center text-body ring-inset tabular-nums focus:ring-1 focus:ring-clay focus:outline-none lg:h-11"
        />
        <button
          type="button"
          x-on:click="c.step({{m}}, {{f}}, 1)"
          class="flex size-12 shrink-0 items-center justify-center rounded-r-md hover:bg-sand-hover lg:size-11"
          x-bind:aria-label="'{{t "admin.more"}}: ' + {{f}}.label"
        >{{> icon empty name="plus" class="size-5"}}</button>
      </span>
    </div>
  </template>

  {{!-- Дата: своя кнопка и календарь Cally (механика его, вид наш — main.css).
        Показываем по-русски (30.09.2026), храним как в данных (2026-09-30) --}}
  <template x-if="{{f}}.type === 'date'">
    <div
      class="flex flex-col gap-2"
      x-data="{ open: false, shown: null }"
      x-on:keydown.escape="open && ((open = false), $refs.trigger.focus())"
      x-on:click.outside="open = false"
    >
      <span class="text-small font-medium">
        <span x-text="{{f}}.label"></span><span x-show="{{f}}.required" class="text-error" aria-hidden="true"> *</span>
      </span>
      <div class="relative w-full sm:max-w-xs">
        <button
          type="button"
          x-ref="trigger"
          aria-haspopup="dialog"
          x-bind:aria-expanded="open"
          x-bind:aria-label="{{f}}.label + ': ' + (c.value({{m}}, {{f}}) ? c.day(c.value({{m}}, {{f}})) : '{{t "admin.chooseDate"}}')"
          x-on:click="open = !open; open && $nextTick(() => $refs.calendar.focus())"
          class="{{> select-trigger-class}}"
        >
          <span class="tabular-nums" x-bind:class="c.value({{m}}, {{f}}) ? '' : 'text-charcoal/70'" x-text="c.value({{m}}, {{f}}) ? c.day(c.value({{m}}, {{f}})) : '{{t "admin.chooseDate"}}'"></span>
          {{> icon empty name="calendar" class="size-5 shrink-0"}}
        </button>
        {{!-- Семь дней по 44 px — 308: под полем внутри карточки на 360 это не влезает,
              поэтому на телефоне календарь всплывает посреди экрана, с 640 — под полем --}}
        <div
          x-show="open"
          x-cloak
          role="dialog"
          x-bind:aria-label="{{f}}.label"
          class="fixed top-1/2 left-1/2 z-20 flex -translate-1/2 flex-col gap-2 rounded-md border border-border bg-cream p-2 shadow-md
            sm:absolute sm:top-full sm:left-0 sm:mt-1 sm:translate-none sm:p-3"
        >
          <calendar-date
            x-ref="calendar"
            class="admin-calendar"
            locale="ru-RU"
            first-day-of-week="1"
            format-weekday="short"
            x-bind:value="c.value({{m}}, {{f}})"
            x-on:change="c.update({{m}}, {{f}}, $event.target.value); open = false; $nextTick(() => $refs.trigger.focus())"
            x-on:focusday="shown = $event.detail"
          >
            {{!-- Заголовок свой — «август 2026» одной строкой: у библиотеки год и месяц
                  стоят в двух местах, между стрелками один год --}}
            <span slot="heading" x-text="c.monthTitle(shown ?? c.value({{m}}, {{f}}))"></span>
            <span slot="previous">{{> icon empty name="chevron-left" class="size-5"}}<span class="sr-only">{{t "admin.prevMonth"}}</span></span>
            <span slot="next">{{> icon empty name="chevron-right" class="size-5"}}<span class="sr-only">{{t "admin.nextMonth"}}</span></span>
            <calendar-month></calendar-month>
          </calendar-date>
          {{!-- Только у поля, которое может быть пустым: даты статьи, товара и отзыва
                обязательны, пустая остановила бы сборку сайта --}}
          <template x-if="{{f}}.nullable && c.value({{m}}, {{f}})">
            <button type="button" x-on:click="c.update({{m}}, {{f}}, ''); open = false; $nextTick(() => $refs.trigger.focus())" class="inline-flex min-h-11 items-center gap-2 self-start text-small text-error hover:underline">
              {{> icon empty name="x" class="size-4"}}{{t "admin.clearDate"}}
            </button>
          </template>
        </div>
      </div>
    </div>
  </template>

  <template x-if="{{f}}.type === 'textarea'">
    <label class="flex flex-col gap-2">
      <span class="text-small font-medium">
        <span x-text="{{f}}.label"></span><span x-show="{{f}}.required" class="text-error" aria-hidden="true"> *</span>
      </span>
      <textarea
        x-bind:rows="{{f}}.rows ?? 4"
        x-bind:value="c.value({{m}}, {{f}})"
        x-on:input="c.update({{m}}, {{f}}, $event.target.value)"
        class="{{> field-box}} h-auto px-4 py-3 lg:h-auto"
      ></textarea>
    </label>
  </template>

  {{!-- Галочка с пояснением рядом: что изменится на сайте, видно до нажатия --}}
  <template x-if="{{f}}.type === 'bool'">
    <label class="flex min-h-12 cursor-pointer items-start gap-3 rounded-lg border border-line px-4 py-3 hover:bg-sand-hover">
      {{#> checkbox-box}}x-bind:checked="c.value({{m}}, {{f}})" x-on:change="c.update({{m}}, {{f}}, $event.target.checked)"{{/checkbox-box}}
      <span class="flex flex-col gap-1">
        <span class="font-medium" x-text="{{f}}.label"></span>
        <span x-show="{{f}}.hint" class="text-small text-charcoal/70" x-text="{{f}}.hint"></span>
      </span>
    </label>
  </template>

  {{!-- Цвет: палитру открывает браузер (своей в проекте нет и не нужно), но образец
        и код цвета — наши: рамку браузера вокруг образца снимает main.css --}}
  <template x-if="{{f}}.type === 'color'">
    <label class="flex flex-col gap-2">
      <span class="text-small font-medium" x-text="{{f}}.label"></span>
      <span class="flex items-center gap-3">
        <input
          type="color"
          x-bind:value="c.value({{m}}, {{f}})"
          x-on:input="c.update({{m}}, {{f}}, $event.target.value.toUpperCase())"
          class="color-swatch size-12 shrink-0 cursor-pointer rounded-md border border-border lg:size-11"
        />
        <span class="flex flex-col">
          <span class="font-medium tabular-nums" x-text="c.value({{m}}, {{f}})"></span>
          <span class="text-small text-charcoal/70">{{t "admin.colorHint"}}</span>
        </span>
      </span>
    </label>
  </template>

  {{!-- Выбор из списка: варианты из схемы, из другого раздела или тем вопросов --}}
  <template x-if="{{f}}.type === 'select' || {{f}}.type === 'ref'">
    {{> admin/select m=m f=f}}
  </template>

  {{!-- Одно фото или ролик: крупное превью, имя файла человеку не нужно --}}
  <template x-if="{{f}}.type === 'image'">
    <div class="flex flex-col gap-2">
      <span class="text-small font-medium">
        <span x-text="{{f}}.label"></span><span x-show="{{f}}.required" class="text-error" aria-hidden="true"> *</span>
      </span>
      <div class="flex flex-wrap items-center gap-4">
        <button
          type="button"
          x-on:click="c.choose({{m}}, {{f}})"
          class="flex size-32 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-line bg-sand hover:bg-sand-hover"
          aria-label="{{t "admin.chooseImage"}}"
        >
          <template x-if="c.preview(c.value({{m}}, {{f}}))">
            <img x-bind:src="c.preview(c.value({{m}}, {{f}}))" alt="" class="size-full object-cover" />
          </template>
          <template x-if="!c.preview(c.value({{m}}, {{f}}))">
            <span class="flex flex-col items-center gap-1 px-2 text-center text-caption text-charcoal/70">
              {{> icon empty name="image" class="size-6"}}
              <span x-text="!c.value({{m}}, {{f}}) ? '{{t "admin.noImage"}}' : {{f}}.flow === 'video' ? '{{t "admin.videoChosen"}}' : '{{t "admin.processing"}}'"></span>
            </span>
          </template>
        </button>
        <div class="flex flex-col items-start gap-2">
          <button type="button" x-on:click="c.choose({{m}}, {{f}})" class="inline-flex min-h-11 items-center gap-2 font-medium text-clay hover:text-clay-hover">
            {{> icon empty name="upload" class="size-5"}}<span x-text="c.value({{m}}, {{f}}) ? '{{t "admin.replaceImage"}}' : '{{t "admin.chooseImage"}}'"></span>
          </button>
          <template x-if="({{f}}.nullable || !{{f}}.required) && c.value({{m}}, {{f}})">
            <button type="button" x-on:click="c.update({{m}}, {{f}}, '')" class="inline-flex min-h-11 items-center gap-2 text-small text-error hover:underline">
              {{> icon empty name="x" class="size-4"}}{{t "admin.removeImage"}}
            </button>
          </template>
        </div>
      </div>
    </div>
  </template>

  {{!-- Несколько фото по порядку: первое — главное --}}
  <template x-if="{{f}}.type === 'images'">
    <div class="flex flex-col gap-2">
      <span class="text-small font-medium" x-text="{{f}}.label"></span>
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4">
        <template x-for="(id, index) in c.imagesOf({{m}}, {{f}})" x-bind:key="id + index">
          <li class="flex flex-col gap-1">
            <span class="relative flex aspect-square w-full items-center justify-center overflow-hidden rounded-lg border border-line bg-sand">
              <template x-if="c.preview(id)">
                <img x-bind:src="c.preview(id)" alt="" class="size-full object-cover" />
              </template>
              <template x-if="!c.preview(id)">
                <span class="px-2 text-center text-caption text-charcoal/70">{{t "admin.processing"}}</span>
              </template>
              <span x-show="index === 0" class="absolute top-2 left-2 rounded-sm bg-cream px-2 text-caption">{{t "admin.mainPhoto"}}</span>
            </span>
            <span class="flex justify-between gap-2">
              <button type="button" x-on:click="c.move(c.listOf({{m}}, {{f}}), index, -1)" x-bind:disabled="index === 0" class="flex size-11 items-center justify-center rounded-md hover:bg-sand-hover disabled:opacity-30" aria-label="{{t "admin.moveLeft"}}">{{> icon empty name="chevron-left" class="size-5"}}</button>
              <button type="button" x-on:click="c.removeRow({{m}}, {{f}}, index)" class="flex size-11 items-center justify-center rounded-md text-error hover:bg-sand-hover" aria-label="{{t "admin.removeImage"}}">{{> icon empty name="trash-2" class="size-5"}}</button>
              <button type="button" x-on:click="c.move(c.listOf({{m}}, {{f}}), index, 1)" x-bind:disabled="index === c.imagesOf({{m}}, {{f}}).length - 1" class="flex size-11 items-center justify-center rounded-md hover:bg-sand-hover disabled:opacity-30" aria-label="{{t "admin.moveRight"}}">{{> icon empty name="chevron-right" class="size-5"}}</button>
            </span>
          </li>
        </template>
        <li>
          <button
            type="button"
            x-on:click="c.choose({{m}}, {{f}})"
            class="flex aspect-square w-full flex-col items-center justify-center gap-2 rounded-lg border border-dashed border-border px-2 text-center text-small font-medium text-clay hover:bg-sand-hover"
          >{{> icon empty name="plus" class="size-6"}}{{t "admin.addImage"}}</button>
        </li>
      </ul>
    </div>
  </template>

  {{!-- Список строк: пункты раздела --}}
  <template x-if="{{f}}.type === 'strings'">
    <div class="flex flex-col gap-2">
      <span class="text-small font-medium" x-text="{{f}}.label"></span>
      <template x-for="(text, index) in c.listOf({{m}}, {{f}})" x-bind:key="index">
        <div class="flex items-start gap-2">
          <span class="flex h-11 w-6 shrink-0 items-center justify-end text-small text-charcoal/70 tabular-nums" x-text="(index + 1) + '.'"></span>
          <textarea
            rows="2"
            x-bind:value="text"
            x-on:input="c.setString({{m}}, {{f}}, index, $event.target.value)"
            class="{{> field-box}} h-auto flex-1 px-4 py-2 lg:h-auto"
          ></textarea>
          <button type="button" x-on:click="c.removeRow({{m}}, {{f}}, index)" class="flex size-11 shrink-0 items-center justify-center rounded-md text-error hover:bg-sand-hover" aria-label="{{t "admin.remove"}}">{{> icon empty name="trash-2" class="size-5"}}</button>
        </div>
      </template>
      <div>
        <button type="button" x-on:click="c.addRow({{m}}, {{f}})" class="inline-flex min-h-11 items-center gap-2 text-small font-medium text-clay hover:text-clay-hover">{{> icon empty name="plus" class="size-4"}}{{t "admin.addPoint"}}</button>
      </div>
    </div>
  </template>

  {{#unless nested}}
    {{!-- Ссылки на записи другого раздела: отметить нужные --}}
    <template x-if="{{f}}.type === 'refs'">
      <fieldset class="flex flex-col gap-2">
        <legend class="text-small font-medium" x-text="{{f}}.label"></legend>
        <div class="scrollbar-soft mt-2 grid max-h-80 gap-1 overflow-y-auto rounded-lg border border-line p-2 sm:grid-cols-2">
          <template x-for="option in c.selectOptions({{f}})" x-bind:key="option.value">
            <label class="flex min-h-12 cursor-pointer items-center gap-3 rounded-md px-2 hover:bg-sand-hover">
              {{#> checkbox-box}}x-bind:checked="c.refs({{m}}, {{f}}).includes(option.value)" x-on:change="c.toggleRef({{m}}, {{f}}, option.value)"{{/checkbox-box}}
              <span class="flex size-9 shrink-0 items-center justify-center overflow-hidden rounded-sm bg-sand">
                <template x-if="option.thumb">
                  <img x-bind:src="option.thumb" alt="" class="size-full object-cover" />
                </template>
              </span>
              <span class="min-w-0" x-text="option.label"></span>
            </label>
          </template>
        </div>
      </fieldset>
    </template>

    {{!-- Вложенные записи: цвета, разделы статьи, кадры поста --}}
    <template x-if="{{f}}.type === 'list'">
      <div class="flex flex-col gap-3">
        <span class="text-small font-medium" x-text="{{f}}.label"></span>
        <template x-for="(row, rowIndex) in c.listOf({{m}}, {{f}})" x-bind:key="rowIndex">
          {{!-- Новая пустая запись раскрыта, заполненные свёрнуты. Один раз при появлении:
                привязка к названию свернула бы строку прямо во время ввода --}}
          <details class="group rounded-xl border border-line bg-cream" x-init="$el.open = c.title(row, {{f}}) === '—'">
            <summary class="flex min-h-16 flex-wrap items-center gap-3 px-3 py-2 sm:px-4">
              {{> icon empty name="chevron-right" class="size-5 text-charcoal/70 transition-transform duration-150 group-open:rotate-90"}}
              <template x-if="row.swatch">
                <span class="size-6 shrink-0 rounded-full border border-line" x-bind:style="{ backgroundColor: row.swatch }"></span>
              </template>
              <template x-if="c.rowThumb(row)">
                <img x-bind:src="c.rowThumb(row)" alt="" class="hidden size-12 shrink-0 rounded-md object-cover sm:block" />
              </template>
              <span class="min-w-32 flex-1">
                <span class="block truncate font-medium" x-text="c.title(row, {{f}}) === '—' ? '{{t "admin.newRow"}}' : c.title(row, {{f}})"></span>
                <span x-show="c.rowNote(row)" class="block truncate text-small text-charcoal/70" x-text="c.rowNote(row)"></span>
              </span>
              <span class="ml-auto flex shrink-0 gap-2">
              <button type="button" x-on:click.prevent="c.move(c.listOf({{m}}, {{f}}), rowIndex, -1)" x-bind:disabled="rowIndex === 0" class="flex size-11 shrink-0 items-center justify-center rounded-md hover:bg-sand-hover disabled:opacity-30" aria-label="{{t "admin.moveUp"}}">{{> icon empty name="arrow-up" class="size-5"}}</button>
              <button type="button" x-on:click.prevent="c.move(c.listOf({{m}}, {{f}}), rowIndex, 1)" x-bind:disabled="rowIndex === c.listOf({{m}}, {{f}}).length - 1" class="flex size-11 shrink-0 items-center justify-center rounded-md hover:bg-sand-hover disabled:opacity-30" aria-label="{{t "admin.moveDown"}}">{{> icon empty name="arrow-down" class="size-5"}}</button>
              <button type="button" x-on:click.prevent="c.removeRow({{m}}, {{f}}, rowIndex)" class="flex size-11 shrink-0 items-center justify-center rounded-md text-error hover:bg-sand-hover" aria-label="{{t "admin.remove"}}">{{> icon empty name="trash-2" class="size-5"}}</button>
              </span>
            </summary>
            <div class="flex flex-col gap-5 border-t border-line p-4">
              <template x-for="sub in c.simple({{f}}.fields)" x-bind:key="sub.key">
                {{> admin/field m="row" f="sub" nested=true}}
              </template>
              <template x-if="c.advanced({{f}}.fields).length">
                <details class="rounded-lg bg-sand px-4">
                  <summary class="flex min-h-11 items-center text-small font-medium">{{t "admin.advanced"}}</summary>
                  <div class="flex flex-col gap-5 pb-4">
                    <p class="text-small text-charcoal/70">{{t "admin.advancedHint"}}</p>
                    <template x-for="sub in c.advanced({{f}}.fields)" x-bind:key="sub.key">
                      {{> admin/field m="row" f="sub" nested=true}}
                    </template>
                  </div>
                </details>
              </template>
            </div>
          </details>
        </template>
        <div>
          <button type="button" x-on:click="c.addRow({{m}}, {{f}})" class="inline-flex min-h-11 items-center gap-2 font-medium text-clay hover:text-clay-hover">
            {{> icon empty name="plus" class="size-5"}}<span>{{t "admin.add"}} <span x-text="{{f}}.item"></span></span>
          </button>
        </div>
      </div>
    </template>
  {{/unless}}

  <template x-if="{{f}}.hint && {{f}}.type !== 'bool'">
    <p class="text-small text-charcoal/70" x-text="{{f}}.hint"></p>
  </template>
</div>

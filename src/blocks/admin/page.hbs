{{!-- Админка владельца (страницы.md §17, бэкенд.md §13, §15) — по-русски (решение
      владельца 30.09.2026, словарь data/dictionaries/admin.ru.json). Вход по паролю →
      меню разделов: заказы, сообщения и контент сайта. Состояние заказов живёт
      в store `admin` (src/scripts/admin.js), контента — в `adminContent`
      (src/scripts/admin-content.js): окна подтверждения лежат прямыми потомками body
      и делят его со страницей. Строки, которые скрипт подставляет сам (состояния,
      хронология, ошибки), отдаются data-атрибутами — строк в скриптах не бывает.
      Noindex и Disallow: страница служебная и под паролем. --}}
<main
  id="contenido"
  class="page-container flex flex-1 flex-col py-6 lg:py-10"
  x-data="{ a: $store.admin }"
  x-init="a.start($el)"
  data-admin
  data-sections="{{adminSectionIds}}"
  data-t-conflict="{{t "admin.conflict"}}"
  data-t-save-failed="{{t "admin.saveFailed"}}"
  data-t-required-field="{{t "admin.requiredField"}}"
  data-t-min-items="{{t "admin.minItems" n="{n}"}}"
  data-t-main-group="{{t "admin.mainGroup"}}"
  data-t-out-of-stock="{{t "admin.outOfStock"}}"
  data-t-on-home="{{t "admin.onHome"}}"
  data-t-not-saved="{{t "admin.notSaved"}}"
  data-t-colors="{{t "admin.colors" n="{n}"}}"
  data-t-photos="{{t "admin.photos" n="{n}"}}"
  data-t-no-photos="{{t "admin.noPhotos"}}"
  data-t-upload-partial="{{t "admin.uploadPartial" done="{done}" total="{total}"}}"
  data-t-upload-failed="{{t "admin.uploadFailed"}}"
  data-t-build-pending="{{t "admin.buildPending"}}"
  data-t-build-building="{{t "admin.buildBuilding"}}"
  data-t-build-ok="{{t "admin.buildOk"}}"
  data-t-build-error="{{t "admin.buildError"}}"
  data-t-build-unknown="{{t "admin.buildUnknown"}}"
  data-t-wrong-password="{{t "admin.wrongPassword"}}"
  data-t-too-many-attempts="{{t "admin.tooManyAttempts"}}"
  data-t-action-failed="{{t "admin.actionFailed"}}"
  data-t-required="{{t "admin.errRequired"}}"
  data-t-network="{{t "admin.errNetwork"}}"
  data-t-status-created="{{t "admin.statusCreated"}}"
  data-t-status-pending="{{t "admin.statusPending"}}"
  data-t-status-paid="{{t "admin.statusPaid"}}"
  data-t-status-shipped="{{t "admin.statusShipped"}}"
  data-t-status-rejected="{{t "admin.statusRejected"}}"
  data-t-status-cancelled="{{t "admin.statusCancelled"}}"
  data-t-status-refunded="{{t "admin.statusRefunded"}}"
  data-t-status-review="{{t "admin.statusReview"}}"
  data-t-event-created="{{t "admin.eventCreated"}}"
  data-t-event-payment-started="{{t "admin.eventPaymentStarted"}}"
  data-t-event-payment-skipped="{{t "admin.eventPaymentSkipped"}}"
  data-t-event-payment-unavailable="{{t "admin.eventPaymentUnavailable"}}"
  data-t-event-webhook-received="{{t "admin.eventWebhookReceived"}}"
  data-t-event-status-changed="{{t "admin.eventStatusChanged" from="{from}" to="{to}"}}"
  data-t-event-payment-recorded="{{t "admin.eventPaymentRecorded"}}"
  data-t-event-payment-ignored="{{t "admin.eventPaymentIgnored"}}"
  data-t-event-transition-refused="{{t "admin.eventTransitionRefused"}}"
  data-t-event-email-customer-sent="{{t "admin.eventEmailCustomerSent"}}"
  data-t-event-email-customer-failed="{{t "admin.eventEmailCustomerFailed"}}"
  data-t-event-email-owner-sent="{{t "admin.eventEmailOwnerSent"}}"
  data-t-event-email-owner-failed="{{t "admin.eventEmailOwnerFailed"}}"
  data-t-event-shipped="{{t "admin.eventShipped"}}"
  data-t-event-cancelled-by-owner="{{t "admin.eventCancelledByOwner"}}"
  data-t-event-resolved="{{t "admin.eventResolved" to="{to}"}}"
  data-t-msg-new="{{t "admin.msgNew"}}"
  data-t-msg-attended="{{t "admin.msgAttended"}}"
  data-t-msg-approved="{{t "admin.msgApproved"}}"
  data-t-msg-rejected="{{t "admin.msgRejected"}}"
  {{!-- Названия типов и подписи полей сообщений — из scripts/message-fields.js, того же
        списка, которым подписаны письма владельцу --}}
  {{#each adminMessageTypes}}data-t-type-{{type}}="{{t key}}" {{/each}}
  {{#each adminMessageLabels}}data-l-{{field}}="{{t key}}" {{/each}}
>
  {{!-- Большого заголовка «Админка» нет (владелец 30.09.2026: «место занимает и не
        функционален»); название страницы для диктора — sr-only. Публикация и выход —
        в шапке (admin/header-actions); на телефоне публикация здесь: в шапке рядом
        с выходом ей тесно --}}
  <h1 x-show="a.auth === 'in'" x-cloak class="sr-only">{{t "admin.title"}}</h1>
  <div x-show="a.auth === 'in'" x-cloak class="mb-2 sm:hidden">{{> admin/build-status}}</div>

  {{!-- Сессия ещё проверяется: место под форму или список, чтобы страница не прыгала --}}
  <div x-show="a.auth === 'checking'" aria-hidden="true" class="mt-8 flex max-w-sm flex-col gap-4">
    <div class="h-7 w-2/3 rounded-sm bg-sand"></div>
    <div class="h-12 w-full rounded-lg bg-sand"></div>
    <div class="h-12 w-1/2 rounded-lg bg-sand"></div>
  </div>

  {{!-- Вход: один пароль, без логинов и ролей (бэкенд.md §13). Карточка по центру,
        без слова «админка»: страница открыта всем (владелец 30.09.2026).
        Ошибка — в строке сообщения самого поля, как у всех полей сайта: отдельной
        строкой ниже она уезжала от поля. Поле ведёт себя как в живой форме (live),
        только ошибки приходят не из проверки формы, а из ответа сервера.
        «Запомнить» — месяц без входа, иначе выход при закрытии браузера (бэкенд.md §13) --}}
  <form
    x-show="a.auth === 'out'"
    x-cloak
    novalidate
    x-data="{ get errors() { return { password: this.$store.admin.loginError } }, warnings: {}, valids: {} }"
    x-on:submit.prevent="a.login($event.target.elements.password.value, $event.target.elements.remember.checked)"
    class="m-auto flex w-full max-w-sm flex-col gap-6 rounded-xl border border-line bg-cream p-6 lg:p-8"
  >
    {{!-- Шапки до входа нет: знак бренда — здесь, ссылкой на магазин --}}
    <a href="/" class="flex min-h-11 items-center justify-center">{{> wordmark empty}}</a>
    <div class="flex flex-col items-center gap-3 text-center">
      <span class="flex size-12 items-center justify-center rounded-full bg-sand text-clay">
        {{> icon empty name="lock" class="size-6"}}
      </span>
      {{!-- Заголовок страницы входа — он и есть главный: «Вход», без слова «админка» --}}
      <h1 class="text-h3 lg:text-h3-lg">{{t "admin.loginTitle"}}</h1>
    </div>
    <div class="flex flex-col gap-2">
      {{> field empty id="admin-password" name="password" type="password" label="admin.password"
          required=true autocomplete="current-password" live=true reveal=true
          revealLabel="admin.showPassword" messageOnError=true}}
      {{> checkbox empty name="remember" label="admin.remember"}}
    </div>
    {{> button empty primary=true sizeLg=true fullWidth=true submit=true bindLoading="a.loggingIn"
        label="admin.enter"}}
  </form>

  {{!-- Вошли: меню разделов слева (с 1024), справа выбранный раздел. На телефоне меню
        прячется в окно — кнопка с названием текущего раздела открывает его --}}
  <div x-show="a.auth === 'in'" x-cloak class="lg:grid lg:grid-cols-[15rem_minmax(0,1fr)] lg:gap-10">
    <aside class="hidden lg:block">
      {{> admin/nav}}
    </aside>

    <div class="min-w-0">
  <button
    type="button"
    x-show="!a.order"
    x-on:click="$store.overlay.open('admin-nav')"
    class="flex min-h-12 w-full items-center gap-3 rounded-lg border border-border px-4 text-left
      font-medium lg:hidden"
  >
    {{> icon empty name="menu" class="size-5"}}
    <span class="min-w-0 flex-1 truncate" x-text="a.sectionName()"></span>
    <span class="text-small text-clay">{{t "admin.sectionsOpen"}}</span>
  </button>

  {{!-- Список заказов --}}
  <div x-show="a.auth === 'in' && a.section === 'orders' && !a.order" x-cloak class="mt-6 lg:mt-0">
    {{!-- Вкладки (компоненты.md 4.4): на узком экране прокручиваются по горизонтали --}}
    {{#> scroll-strip label="admin.tabs" class="-mx-4 sm:mx-0" stripClass="gap-2 px-4 sm:px-0"}}
      {{#each adminTabs}}
        <button
          type="button"
          role="tab"
          data-tab="{{id}}"
          x-bind:aria-selected="a.tab === '{{id}}'"
          x-bind:tabindex="a.tab === '{{id}}' ? 0 : -1"
          x-on:click="a.setTab('{{id}}')"
          x-on:keydown="a.tabKey($event)"
          x-bind:class="a.tab === '{{id}}' ? 'border-clay text-clay' : 'border-transparent text-charcoal/70 hover:text-charcoal'"
          class="min-h-11 shrink-0 border-b-2 px-3 font-medium whitespace-nowrap transition-colors
            duration-150"
        >{{t label}}</button>
      {{/each}}
    {{/scroll-strip}}

    <form class="mt-4 max-w-xs" x-on:submit.prevent="a.search($event.target.elements.q.value)">
      {{> field empty id="admin-q" name="q" label="admin.search" inputmode="numeric"
          placeholder="admin.searchPlaceholder"}}
    </form>

    <div x-show="a.list === 'loading'" aria-hidden="true" class="mt-4 flex flex-col gap-3">
      <div class="h-20 rounded-xl bg-sand"></div>
      <div class="h-20 rounded-xl bg-sand"></div>
      <div class="h-20 rounded-xl bg-sand"></div>
    </div>

    <div x-show="a.list === 'failed'" x-cloak class="mt-6 flex flex-col items-start gap-3">
      <p role="alert" class="flex items-start gap-2 text-error">
        <span class="icon-line shrink-0">{{> icon empty name="circle-alert" class="size-4"}}</span>
        {{t "admin.errNetwork"}}
      </p>
      {{> button empty secondary=true sizeMd=true label="admin.retry" onClick="a.load()"}}
    </div>

    <div x-show="a.list === 'ready'" x-cloak>
      <p x-show="!a.orders.length" class="mt-6 text-charcoal/70">{{t "admin.empty"}}</p>

      {{!-- Строка заказа: на телефоне карточка, с 1024 — колонки таблицы --}}
      <ul x-show="a.orders.length" class="mt-4 flex flex-col gap-3">
        <template x-for="row in a.orders" x-bind:key="row.number">
          <li>
            <button
              type="button"
              x-on:click="a.openOrder(row.number)"
              class="grid w-full gap-x-4 gap-y-1 rounded-xl border border-line bg-cream p-4 text-left
                transition-colors duration-150 hover:bg-sand-hover lg:grid-cols-[7rem_1fr_1fr_8rem_9rem]
                lg:items-center"
            >
              <span class="font-medium tabular-nums" x-text="'#' + row.number"></span>
              <span class="text-small text-charcoal/70 lg:order-4 lg:text-body lg:text-charcoal"
                x-text="a.fmtDate(row.createdAt)"></span>
              <span class="lg:order-2" x-text="row.name"></span>
              <span class="text-small text-charcoal/70 lg:order-3 lg:text-body lg:text-charcoal"
                x-text="row.place"></span>
              <span class="mt-2 flex items-center justify-between gap-3 lg:order-5 lg:mt-0 lg:contents">
                <span class="font-medium tabular-nums lg:order-4" x-text="a.fmtMoney(row.total)"></span>
                <span class="lg:order-6">
                  {{> badge empty bindKind="a.statusKind(a.statusOf(row))" bindText="a.statusLabel(a.statusOf(row))"}}
                </span>
              </span>
            </button>
          </li>
        </template>
      </ul>

      <div x-show="a.hasMore" class="mt-6">
        {{> button empty secondary=true sizeMd=true label="admin.loadMore" bindLoading="a.loadingMore"
            onClick="a.load(true)"}}
      </div>
    </div>
  </div>

  {{!-- Сообщения из форм (бэкенд.md §14): вкладки по типу, строка раскрывается на месте --}}
  <div x-show="a.auth === 'in' && a.section === 'messages' && !a.order" x-cloak class="mt-6 lg:mt-0">
    {{#> scroll-strip label="admin.msgTabs" class="-mx-4 sm:mx-0" stripClass="gap-2 px-4 sm:px-0"}}
      {{#each adminMessageTabs}}
        <button
          type="button"
          role="tab"
          data-msg-tab="{{id}}"
          x-bind:aria-selected="a.msgTab === '{{id}}'"
          x-bind:tabindex="a.msgTab === '{{id}}' ? 0 : -1"
          x-on:click="a.setMsgTab('{{id}}')"
          x-on:keydown="a.msgTabKey($event)"
          x-bind:class="a.msgTab === '{{id}}' ? 'border-clay text-clay' : 'border-transparent text-charcoal/70 hover:text-charcoal'"
          class="min-h-11 shrink-0 border-b-2 px-3 font-medium whitespace-nowrap transition-colors
            duration-150"
        >{{t label}}</button>
      {{/each}}
    {{/scroll-strip}}

    <div x-show="a.msgList === 'loading'" aria-hidden="true" class="mt-4 flex flex-col gap-3">
      <div class="h-20 rounded-xl bg-sand"></div>
      <div class="h-20 rounded-xl bg-sand"></div>
    </div>

    <div x-show="a.msgList === 'failed'" x-cloak class="mt-6 flex flex-col items-start gap-3">
      <p role="alert" class="flex items-start gap-2 text-error">
        <span class="icon-line shrink-0">{{> icon empty name="circle-alert" class="size-4"}}</span>
        {{t "admin.errNetwork"}}
      </p>
      {{> button empty secondary=true sizeMd=true label="admin.retry" onClick="a.loadMessages()"}}
    </div>

    <div x-show="a.msgList === 'ready'" x-cloak>
      <p x-show="!a.messages.length" class="mt-6 text-charcoal/70">{{t "admin.msgEmpty"}}</p>

      <ul x-show="a.messages.length" class="mt-4 flex flex-col gap-3">
        <template x-for="message in a.messages" x-bind:key="message.id">
          <li class="rounded-xl border border-line bg-cream">
            <button
              type="button"
              x-on:click="a.toggleMessage(message.id)"
              x-bind:aria-expanded="a.openMessage === message.id"
              class="grid w-full gap-x-4 gap-y-1 p-4 text-left transition-colors duration-150
                hover:bg-sand-hover lg:grid-cols-[10rem_11rem_1fr_9rem] lg:items-center"
            >
              <span class="text-small text-charcoal/70 lg:text-body lg:text-charcoal"
                x-text="a.fmtDate(message.createdAt)"></span>
              <span class="font-medium" x-text="a.msgTypeLabel(message.type)"></span>
              <span class="truncate" x-text="a.msgSummary(message)"></span>
              <span class="mt-2 lg:mt-0">
                {{> badge empty bindKind="a.msgStatusKind(message.status)" bindText="a.msgStatusLabel(message.status)"}}
              </span>
            </button>

            <div x-show="a.openMessage === message.id" x-cloak class="border-t border-line p-4">
              <p x-show="message.code" class="mb-3 text-small text-charcoal/70">
                <span>{{t "admin.msgCode"}}</span> <span class="font-medium tabular-nums" x-text="message.code"></span>
              </p>
              {{!-- Письмо с номером обращения не ушло — норма нарушена, владелец должен связаться сам --}}
              <p x-show="message.mailStatus === 'failed'" class="mb-3 flex items-start gap-2 text-small text-error">
                <span class="icon-line shrink-0">{{> icon empty name="circle-alert" class="size-4"}}</span>
                {{t "admin.msgMailFailed"}}
              </p>
              <dl class="flex flex-col gap-2">
                <template x-for="[name, value] in Object.entries(message.fields)" x-bind:key="name">
                  <div class="flex flex-col sm:flex-row sm:gap-4">
                    <dt class="shrink-0 text-small text-charcoal/70 sm:w-40" x-text="a.fieldLabel(name)"></dt>
                    <dd class="whitespace-pre-line" x-text="value"></dd>
                  </div>
                </template>
              </dl>
              <div class="mt-4 flex flex-wrap gap-3">
                <span x-show="message.status === 'new'">
                  {{> button empty secondary=true sizeMd=true label="admin.msgMarkAttended"
                      onClick="a.msgAct(message.id, 'attended')" bindLoading="a.msgActing === message.id"}}
                </span>
                <span x-show="message.type === 'review' && message.status !== 'approved' && message.status !== 'rejected'">
                  {{> button empty primary=true sizeMd=true label="admin.msgPublish"
                      onClick="a.msgAct(message.id, 'approved')" bindLoading="a.msgActing === message.id"}}
                </span>
                <span x-show="message.type === 'review' && message.status !== 'approved' && message.status !== 'rejected'">
                  {{> button empty tertiary=true sizeMd=true label="admin.msgReject"
                      onClick="a.msgAct(message.id, 'rejected')" bindLoading="a.msgActing === message.id"}}
                </span>
              </div>
              <p x-show="message.type === 'review'" class="mt-3 text-small text-charcoal/70">{{t "admin.msgPublishHint"}}</p>
              <p x-show="a.msgActionFailed === message.id" x-cloak role="alert" class="mt-3 flex items-start gap-2 text-small text-error">
                <span class="icon-line shrink-0">{{> icon empty name="circle-alert" class="size-4"}}</span>
                {{t "admin.actionFailed"}}
              </p>
            </div>
          </li>
        </template>
      </ul>

      <div x-show="a.msgHasMore" class="mt-6">
        {{> button empty secondary=true sizeMd=true label="admin.loadMore" bindLoading="a.msgLoadingMore"
            onClick="a.loadMessages(true)"}}
      </div>
    </div>
  </div>

  {{!-- Заказ подробно --}}
  <div x-show="a.auth === 'in' && a.order" x-cloak class="mt-6 lg:mt-0">
    {{!-- «Назад» — та же ссылка, что внизу статьи и игры: стрелка встаёт по левому краю
          текста заказа (у кнопки её сдвигал внутренний отступ) --}}
    {{> link empty nav=true back=true label="admin.back" onClick="a.closeOrder()"}}

    <div x-show="a.detail === 'loading'" aria-hidden="true" class="mt-6 flex flex-col gap-4">
      <div class="h-8 w-1/2 rounded-sm bg-sand"></div>
      <div class="h-32 rounded-xl bg-sand"></div>
      <div class="h-32 rounded-xl bg-sand"></div>
    </div>

    <div x-show="a.detail === 'failed'" x-cloak class="mt-6 flex flex-col items-start gap-3">
      <p role="alert" class="flex items-start gap-2 text-error">
        <span class="icon-line shrink-0">{{> icon empty name="circle-alert" class="size-4"}}</span>
        {{t "admin.errNetwork"}}
      </p>
      {{> button empty secondary=true sizeMd=true label="admin.retry" onClick="a.openOrder(a.order.number, false)"}}
    </div>

    <template x-if="a.order && a.detail === 'ready'">
      {{!-- Заказ разложен по карточкам, у каждого значения — подпись над ним: сплошным
            текстом имя, почта, телефон и адрес сливались (владелец 30.09.2026) --}}
      <div class="mt-4 flex max-w-4xl flex-col gap-6">
        <div class="flex flex-wrap items-center gap-3">
          <h2 class="font-display text-h2 lg:text-h2-lg" x-text="'#' + a.order.number"></h2>
          {{> badge empty bindKind="a.statusKind(a.statusOf(a.order))" bindText="a.statusLabel(a.statusOf(a.order))"}}
          <span class="text-small text-charcoal/70" x-text="a.fmtDate(a.order.createdAt)"></span>
        </div>

        {{!-- Действия: каждое с подтверждением в окне (бэкенд.md §13) --}}
        <div class="flex flex-wrap gap-3" x-show="a.canShip || a.canCancel || a.canResolve">
          <span x-show="a.canShip">
            {{> button empty primary=true sizeMd=true icon="truck" label="admin.actionShip" onClick="a.openAction('admin-ship')"}}
          </span>
          <span x-show="a.canResolve">
            {{> button empty primary=true sizeMd=true label="admin.actionResolve" onClick="a.openAction('admin-resolve')"}}
          </span>
          <span x-show="a.canCancel">
            {{> button empty secondary=true sizeMd=true label="admin.actionCancel" onClick="a.openAction('admin-cancel')"}}
          </span>
        </div>

        <div class="grid gap-4 md:grid-cols-2">
          <section class="flex flex-col gap-4 rounded-xl border border-line bg-cream p-4 lg:p-6">
            <h3 class="flex items-center gap-2 text-h4 lg:text-h4-lg">
              {{> icon empty name="user" class="size-5 text-clay"}}{{t "admin.customer"}}
            </h3>
            <dl class="flex flex-col gap-3">
              <div>
                <dt class="text-small text-charcoal/70">{{t "admin.orderName"}}</dt>
                <dd class="font-medium" x-text="a.order.customer.billing_first_name + ' ' + a.order.customer.billing_last_name"></dd>
              </div>
              <div>
                <dt class="text-small text-charcoal/70">{{t "admin.orderEmail"}}</dt>
                <dd class="break-all">{{> link empty inline=true bindHref="'mailto:' + a.order.customer.billing_email" bindText="a.order.customer.billing_email"}}</dd>
              </div>
              <div class="flex flex-wrap gap-x-8 gap-y-3">
                <div>
                  <dt class="text-small text-charcoal/70">{{t "admin.orderPhone"}}</dt>
                  <dd class="tabular-nums" x-text="a.order.customer.billing_phone"></dd>
                </div>
                <div>
                  <dt class="text-small text-charcoal/70">{{t "admin.dni"}}</dt>
                  <dd class="tabular-nums" x-text="a.order.customer.billing_dni"></dd>
                </div>
              </div>
            </dl>
            <div class="mt-auto">
              {{> button empty secondary=true sizeMd=true icon="whatsapp" iconFilled=true label="admin.whatsapp"
                  bindHref="a.whatsappUrl(a.order.customer.billing_phone)" external=true}}
            </div>
          </section>

          <section class="flex flex-col gap-4 rounded-xl border border-line bg-cream p-4 lg:p-6">
            <h3 class="flex items-center gap-2 text-h4 lg:text-h4-lg">
              {{> icon empty name="truck" class="size-5 text-clay"}}{{t "admin.delivery"}}
            </h3>
            <dl class="flex flex-col gap-3">
              <div>
                <dt class="text-small text-charcoal/70">{{t "admin.orderAddress"}}</dt>
                <dd>
                  <span class="block" x-text="a.order.customer.billing_address_1"></span>
                  <span class="block" x-show="a.order.customer.billing_address_2" x-text="a.order.customer.billing_address_2"></span>
                </dd>
              </div>
              <div class="flex flex-wrap gap-x-8 gap-y-3">
                <div>
                  <dt class="text-small text-charcoal/70">{{t "admin.orderCity"}}</dt>
                  <dd x-text="a.order.customer.billing_city + ', ' + a.order.customer.stateName"></dd>
                </div>
                <div>
                  <dt class="text-small text-charcoal/70">{{t "admin.orderPostcode"}}</dt>
                  <dd class="tabular-nums" x-text="a.order.customer.billing_postcode"></dd>
                </div>
              </div>
              <div x-show="a.order.customer.billing_references">
                <dt class="text-small text-charcoal/70">{{t "admin.references"}}</dt>
                <dd class="whitespace-pre-line" x-text="a.order.customer.billing_references"></dd>
              </div>
              <div x-show="a.order.tracking">
                <dt class="text-small text-charcoal/70">{{t "admin.tracking"}}</dt>
                <dd class="font-medium tabular-nums" x-text="a.order.tracking"></dd>
              </div>
            </dl>
          </section>
        </div>

        <section class="flex flex-col gap-4 rounded-xl border border-line bg-cream p-4 lg:p-6">
          <h3 class="flex items-center gap-2 text-h4 lg:text-h4-lg">
            {{> icon empty name="package" class="size-5 text-clay"}}{{t "admin.items"}}
          </h3>
          <ul class="flex flex-col divide-y divide-line">
            <template x-for="line in a.order.items" x-bind:key="line.productId + (line.variantId ?? '')">
              <li class="flex items-start justify-between gap-4 py-3 first:pt-0">
                <span class="flex min-w-0 flex-col gap-1">
                  <span class="font-medium" x-text="line.name"></span>
                  <span class="flex flex-wrap items-center gap-2 text-small text-charcoal/70">
                    <span x-show="line.variant" x-text="line.variant"></span>
                    <span class="rounded-full bg-sand px-2 text-charcoal tabular-nums" x-text="'× ' + line.qty"></span>
                  </span>
                </span>
                <span class="shrink-0 font-medium tabular-nums" x-text="a.fmtMoney(line.sum)"></span>
              </li>
            </template>
          </ul>
          <dl class="flex flex-col gap-2 rounded-lg bg-sand p-4">
            <div class="flex justify-between gap-4 text-small text-charcoal/70">
              <dt>{{t "admin.shipping"}}</dt>
              <dd class="tabular-nums" x-text="a.order.shipping ? a.fmtMoney(a.order.shipping) : '{{t "admin.shippingNotIncluded"}}'"></dd>
            </div>
            <div class="flex justify-between gap-4 text-h4 font-semibold lg:text-h4-lg">
              <dt>{{t "admin.total"}}</dt>
              <dd class="tabular-nums" x-text="a.fmtMoney(a.order.total)"></dd>
            </div>
          </dl>
        </section>

        <div class="grid gap-4 md:grid-cols-2">
          <section class="flex flex-col gap-4 rounded-xl border border-line bg-cream p-4 lg:p-6">
            <h3 class="flex items-center gap-2 text-h4 lg:text-h4-lg">
              {{> icon empty name="credit-card" class="size-5 text-clay"}}{{t "admin.payment"}}
            </h3>
            <p x-show="!a.order.payment.id" class="text-charcoal/70">{{t "admin.noPayment"}}</p>
            <dl x-show="a.order.payment.id" class="flex flex-col gap-3">
              <div>
                <dt class="text-small text-charcoal/70">{{t "admin.mpPayment"}}</dt>
                <dd class="tabular-nums" x-text="a.order.payment.id"></dd>
              </div>
              <div>
                <dt class="text-small text-charcoal/70">{{t "admin.mpStatus"}}</dt>
                <dd x-text="a.order.payment.status + (a.order.payment.detail ? ' · ' + a.order.payment.detail : '')"></dd>
              </div>
            </dl>
          </section>

          <section x-show="a.order.customer.order_comments" class="flex flex-col gap-4 rounded-xl border border-line bg-cream p-4 lg:p-6">
            <h3 class="flex items-center gap-2 text-h4 lg:text-h4-lg">
              {{> icon empty name="message-square" class="size-5 text-clay"}}{{t "admin.note"}}
            </h3>
            <p class="whitespace-pre-line" x-text="a.order.customer.order_comments"></p>
          </section>
        </div>

        <section class="flex flex-col gap-4 rounded-xl border border-line bg-cream p-4 lg:p-6">
          <h3 class="flex items-center gap-2 text-h4 lg:text-h4-lg">
            {{> icon empty name="history" class="size-5 text-clay"}}{{t "admin.history"}}
          </h3>
          {{!-- Лента: точка на линии — событие, дата над текстом --}}
          <ol class="ml-1.5 flex flex-col border-l border-line">
            <template x-for="(event, index) in a.order.events" x-bind:key="index">
              <li class="relative flex flex-col gap-1 pb-4 pl-5 last:pb-0">
                <span class="absolute top-1.5 -left-1.5 size-3 rounded-full bg-clay ring-2 ring-cream" aria-hidden="true"></span>
                <span class="text-small text-charcoal/70 tabular-nums" x-text="a.fmtDate(event.at)"></span>
                <span x-text="a.eventText(event)"></span>
                <span x-show="event.detail?.note" class="text-small whitespace-pre-line text-charcoal/70" x-text="event.detail?.note"></span>
                <span x-show="event.detail?.tracking" class="text-small text-charcoal/70 tabular-nums" x-text="event.detail?.tracking"></span>
              </li>
            </template>
          </ol>
        </section>
      </div>
    </template>
  </div>

  {{> admin/content}}
    </div>
  </div>
</main>

{{> admin/modals}}
{{> admin/picker}}

{{#> modal name="admin-nav" closeLabel="admin.close" title="admin.sections"}}
  <div class="pb-4">{{> admin/nav}}</div>
{{/modal}}

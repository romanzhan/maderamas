{{!-- Меню разделов админки группами (страницы.md §17): на компьютере — колонка слева,
      на телефоне — то же меню в окне «Разделы». Одна разметка на оба места; выбор
      сначала закрывает окно и открытую запись (admin.pickSection), потом меняет раздел. Текстовые страницы (pages) своего
      пункта не имеют: они открываются из «Страниц», и подсвечивается этот пункт.
      Точка — в разделе есть несохранённые правки. --}}
<nav aria-label="{{t "admin.sections"}}" class="flex flex-col gap-6">
  {{#each adminNav}}
    <div>
      <p class="px-3 text-caption text-charcoal/70">{{label}}</p>
      <ul class="mt-2 flex flex-col gap-2">
        {{#each items}}
          <li>
            <button
              type="button"
              data-section="{{id}}"
              x-on:click="$store.admin.pickSection('{{id}}')"
              x-bind:aria-current="$store.admin.navActive('{{id}}') ? 'page' : null"
              x-bind:class="$store.admin.navActive('{{id}}') ? 'bg-sand text-clay' : 'text-charcoal hover:bg-sand-hover'"
              class="flex min-h-11 w-full items-center gap-3 rounded-lg px-3 text-left font-medium
                transition-colors duration-150"
            >
              {{> icon empty name=icon filled=filled class="size-5"}}
              <span class="min-w-0 flex-1">{{text}}</span>
              <span x-show="$store.adminContent.isDirty('{{id}}')" x-cloak class="flex shrink-0 items-center">
                <span class="size-2 rounded-full bg-warning" aria-hidden="true"></span>
                <span class="sr-only">{{t "admin.unsavedDot"}}</span>
              </span>
            </button>
          </li>
        {{/each}}
      </ul>
    </div>
  {{/each}}
</nav>

{{!-- Контакты (страницы.md §13). Главное действие страницы — WhatsApp: в Аргентине
      пишут туда, а не заполняют формы, поэтому он стоит выше формы и крупнее её.
      Форма — запасной путь для тех, кто пишет с компьютера.
      Блок точки (адрес, часы, карта) появляется только когда адрес задан в настройках:
      выдумывать его нельзя (принцип 8). Карта — статичный кадр со ссылкой, не iframe:
      чужой скрипт тянет за собой согласие на куки и ломается при смене правил.
      Кадра карты нет в списке проверяемых картинок сборки намеренно: блок не выводится,
      пока нет адреса, и предупреждение о неприсланном файле было бы шумом. Придёт
      адрес — вместе с ним заводится и кадр. --}}
<main id="contenido" class="page-container py-6 lg:py-10">
  {{> breadcrumbs empty items=breadcrumbs.items plain=breadcrumbs.plain}}

  <div class="mt-4 flex flex-col gap-4">
    <h1 class="max-w-prose font-display text-h1 lg:text-h1-lg">{{t "contact.title"}}</h1>
    <p class="max-w-prose text-lead text-charcoal/70">{{t "contact.lead"}}</p>
  </div>

  <section class="mt-8 rounded-2xl bg-sand p-6 lg:mt-10 lg:p-10">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between lg:gap-12">
      <div class="min-w-0">
        <h2 class="font-display text-h3 lg:text-h3-lg">{{t "contact.whatsappTitle"}}</h2>
        <p class="mt-2 max-w-prose text-charcoal/70">{{t "contact.whatsappText"}}</p>
      </div>
      <div class="shrink-0">
        {{> button empty primary=true sizeLg=true icon="whatsapp" iconFilled=true label="whatsapp.cta"
            href=links.whatsapp}}
      </div>
    </div>
  </section>

  <div class="mt-12 grid gap-8 lg:mt-16 lg:grid-cols-3 lg:gap-12">
    <section class="lg:col-span-2">
      <h2 class="font-display text-h2 lg:text-h2-lg">{{t "contact.formTitle"}}</h2>
      <p class="mt-2 max-w-prose text-charcoal/70">{{t "contact.formLead"}}</p>

      <div class="mt-6">
        {{#> form-shell send="contact" submitLabel="contact.submit" successTitle="contact.successTitle"
            successText="contact.successText" againLabel="contact.sendAnother"
            onAction="again()"}}
          {{> field empty live=true id="contacto-nombre" name="nombre" label="fields.name" maxlength=60
              required=true autocomplete="name" pattern=(formPattern "nombre")
              errorPattern="errors.nameFormat"}}

          {{> field empty live=true id="contacto-email" name="email" label="fields.email" maxlength=120
              type="email" inputmode="email" required=true autocomplete="email" checkValid=true}}

          {{> textarea empty live=true id="contacto-mensaje" name="mensaje"
              label="fields.message" required=true minlength=10 max=500
              hint="contact.messageHint"}}
        {{/form-shell}}
      </div>
    </section>

    <aside class="flex flex-col gap-8">
      <div>
        <h2 class="font-display text-h3 lg:text-h3-lg">{{t "contact.channelsTitle"}}</h2>
        <div class="mt-4">
          {{> contact-list}}
        </div>
      </div>

      {{#if site.contacts.address}}
        <div>
          <h2 class="font-display text-h3 lg:text-h3-lg">{{t "contact.addressTitle"}}</h2>
          <p class="mt-3 text-charcoal/70">{{site.contacts.address}}</p>
          {{#if site.contacts.hours}}
            <p class="mt-2 text-charcoal/70">{{site.contacts.hours}}</p>
          {{/if}}

          <a
            href="https://maps.google.com/?q={{site.contacts.address}}"
            target="_blank"
            rel="noopener"
            class="mt-4 block overflow-hidden rounded-xl"
          >
            {{> picture empty id="contacto-mapa" alt=(t "contact.mapAlt")
                ratio="aspect-video" sizes="(min-width: 1024px) 30vw, 100vw"
                class="aspect-video w-full object-cover"}}
            <span class="mt-2 inline-flex text-small text-clay">{{t "contact.mapCta"}}</span>
          </a>
        </div>
      {{/if}}
    </aside>
  </div>
</main>

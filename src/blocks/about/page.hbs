{{!-- «Nosotros» (страницы.md §9). Без фотографий (владелец 30.09.2026: заглушки сняты,
      страница держится на тексте). Сверху вниз: кто мы → история, рядом довод «почему
      растущая» → этапы работы (если есть в данных) → живой отзыв → из чего сделано
      и выход в каталог. Своих фактов у страницы нет: текст и этапы — pages.json, пункты
      о материалах — те же, что на странице товара, отзыв — настоящий, с пометкой
      источника (seo.md п. 5).
      Кнопка в каталог — вывод последней секции, а не отдельная полоса: одна кнопка
      в своей полосе читалась оторванной от страницы (владелец 30.09.2026). Последняя
      секция светлая: тёмная полоса отзыва вплотную к тёмному подвалу слилась бы с ним. --}}
<main id="contenido">
  <div class="page-container pt-6 lg:pt-10">
    {{> breadcrumbs empty items=breadcrumbs.items plain=breadcrumbs.plain}}

    <div class="mt-4 flex flex-col gap-4">
      <h1 class="max-w-prose font-display text-h1 lg:text-h1-lg">{{page.heading}}</h1>
      {{#if page.lead}}
        <p class="max-w-prose text-lead text-charcoal/70 lg:text-lead-lg">{{page.lead}}</p>
      {{/if}}
    </div>
  </div>

  {{!-- История и рядом главный довод бренда. На компьютере карточка едет рядом с текстом,
        пока его читают; на телефоне стоит после истории --}}
  <section class="page-container mt-10 lg:mt-14">
    <div class="grid items-start gap-8 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7">
        {{> prose empty paragraphs=page.body}}
      </div>

      <aside class="rounded-2xl bg-sand p-6 lg:sticky lg:top-(--header-h) lg:col-span-5 lg:p-8">
        <h2 class="font-display text-h3 lg:text-h3-lg">{{t "about.whyTitle"}}</h2>
        <p class="mt-3 text-charcoal/70">{{t "about.whyText"}}</p>
      </aside>
    </div>
  </section>

  {{!-- Как рождается стул: этапы из данных, нумерованные; нет этапов — нет и секции --}}
  {{#if page.sections.length}}
    <section class="page-container mt-12 lg:mt-16">
      <h2 class="font-display text-h2 lg:text-h2-lg">{{t "about.processTitle"}}</h2>
      <p class="mt-3 max-w-prose text-charcoal/70">{{t "about.processLead"}}</p>

      <ol class="step-counter mt-6 grid gap-6 sm:grid-cols-2 lg:mt-8 lg:grid-cols-4 lg:gap-8">
        {{#each page.sections}}
          <li class="flex flex-col gap-3">
            {{!-- Номер рисует счётчик CSS: держать цифры в данных значило бы следить,
                  чтобы они не разошлись с порядком этапов --}}
            <span
              data-step
              aria-hidden="true"
              class="flex size-12 items-center justify-center rounded-full bg-sand
                font-display text-h4 text-clay tabular-nums lg:text-h4-lg"
            ></span>
            <h3 class="text-h4 lg:text-h4-lg">{{title}}</h3>
            {{> prose ../empty paragraphs=body}}
          </li>
        {{/each}}
      </ol>
    </section>
  {{/if}}

  {{!-- Живой отзыв во всю ширину. Отзыв с Mercado Libre обязан нести пометку источника
        и ссылку на оригинал (seo.md п. 5), поэтому имя автора здесь — ссылка --}}
  {{#if home.reviews.length}}
    {{#with home.reviews.[0]}}
      <section class="surface-dark mt-12 bg-walnut text-cream lg:mt-16">
        <div class="page-container py-12 lg:py-16">
          <figure class="mx-auto flex max-w-prose flex-col items-center gap-6 text-center">
            <blockquote class="font-display text-h3 lg:text-h3-lg">{{text}}</blockquote>
            <figcaption class="flex flex-wrap items-center justify-center gap-x-2 text-small
              text-cream/75">
              {{#if sourceUrl}}
                <a href="{{sourceUrl}}" target="_blank" rel="noopener nofollow"
                  class="underline underline-offset-2 hover:text-cream">{{author}}</a>
              {{else}}
                <span>{{author}}</span>
              {{/if}}
              <span aria-hidden="true">·</span>
              <span>{{t "home.reviewsFromMl"}}</span>
            </figcaption>
          </figure>
        </div>
      </section>
    {{/with}}
  {{/if}}

  {{!-- Из чего сделана (те же пункты, что на странице товара и на «Cómo funciona»)
        и вывод страницы — в каталог. Без отзыва полоса встаёт с обычным отступом --}}
  <section class="bg-sand {{#unless home.reviews.length}}mt-12 lg:mt-16{{/unless}}">
    <div class="page-container py-12 lg:py-16">
      <h2 class="font-display text-h2 lg:text-h2-lg">{{t "about.materialsTitle"}}</h2>
      <p class="mt-3 max-w-prose text-charcoal/70">{{t "about.materialsLead"}}</p>

      <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:mt-8 lg:grid-cols-4">
        {{#each safety}}
          <li>
            {{> feature-item ../empty icon=icon
                title=(concat "product.safety" key "")
                text=(concat "product.safety" key "Text")}}
          </li>
        {{/each}}
      </ul>

      <div class="mt-10 flex justify-center lg:mt-12">
        {{> button empty primary=true sizeLg=true label="home.heroCta" href=nav.catalogHref}}
      </div>
    </div>
  </section>
</main>

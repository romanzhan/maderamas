{{!-- «Спасибо» (страницы.md §8). Номер заказа приходит от чекаута через sessionStorage;
      прямой заход без заказа уводит на главную — показывать здесь нечего.
      Корзина очищается при открытии этой страницы, а не при отправке: заказ считается
      оформленным, когда покупатель сюда дошёл.
      С WooCommerce страница станет штатной order-received, поэтому блоки те же:
      номер → что дальше → контакты → «продолжить покупки». --}}
<main id="contenido" class="page-container py-6 pb-12 lg:py-10 lg:pb-20" x-data="thanksPage()">
  <div x-show="ready" x-cloak>
    {{> breadcrumbs empty items=breadcrumbs.items plain=breadcrumbs.plain}}

    <div class="mx-auto mt-8 flex max-w-prose flex-col items-center gap-6 lg:mt-12">
      <span
        class="flex size-14 items-center justify-center rounded-full bg-success-bg text-success"
      >{{> icon empty name="check" class="size-6"}}</span>

      <div class="flex flex-col items-center gap-3 text-center">
        <h1 class="font-display text-h1 lg:text-h1-lg">{{t "thanks.title"}}</h1>
        <p class="text-lead text-charcoal/70">{{t "thanks.lead"}}</p>
      </div>

      {{!-- Номер приходит из браузера, поэтому строка словаря отдаётся в data-атрибуте --}}
      <p
        class="w-full rounded-xl bg-sand px-4 py-3 text-center font-medium tabular-nums"
        data-order="{{t "thanks.order" n="{n}"}}"
        x-text="$el.dataset.order.replace('{n}', () => number)"
      ></p>

      <section class="w-full">
        <h2 class="font-display text-h3 lg:text-h3-lg">{{t "thanks.nextTitle"}}</h2>
        <ul class="mt-4 flex flex-col gap-4">
          <li>
            {{> feature-item empty inline=true icon="truck" title="thanks.nextPrepare"}}
          </li>
          <li>
            {{> feature-item empty inline=true icon="whatsapp" iconFilled=true
                title="thanks.nextContact"}}
          </li>
        </ul>
      </section>

      <section class="w-full">
        <h2 class="font-display text-h3 lg:text-h3-lg">{{t "thanks.contactTitle"}}</h2>
        <div class="mt-4">
          {{> contact-list}}
        </div>
      </section>

      <div class="mt-2">
        {{> button empty primary=true sizeLg=true label="thanks.continue" href=nav.catalogHref}}
      </div>
    </div>
  </div>
</main>

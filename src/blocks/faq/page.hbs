{{!-- Частые вопросы (страницы.md §12). Источник один — data/faq.json, тот же, что
      у блока на главной; здесь вопросы разложены по темам, а подпись темы приходит
      из словаря по её id.
      Раскладка как у блока главной: заголовок слева, вопросы справа — одной колонкой
      посреди широкого экрана справа оставалась бы пустота.
      Вопрос открывается по якорю из URL (компоненты.md 4.5) — это умеет сама строка
      аккордеона, поэтому ссылка вида /preguntas-frecuentes/#envio-costo работает
      и из письма, и из чата. --}}
<main id="contenido" class="page-container py-6 lg:py-10">
  {{> breadcrumbs empty items=breadcrumbs.items plain=breadcrumbs.plain}}

  <div class="mt-4 flex flex-col gap-4">
    <h1 class="max-w-prose font-display text-h1 lg:text-h1-lg">{{t "footer.faq"}}</h1>
    <p class="max-w-prose text-lead text-charcoal/70">{{t "faq.lead"}}</p>
  </div>

  <div class="mt-8 flex flex-col gap-10 lg:mt-12 lg:gap-12">
    {{#each faqPage.topics}}
      <section class="grid gap-4 lg:grid-cols-3 lg:gap-12">
        <h2 class="font-display text-h2 lg:text-h2-lg">{{label}}</h2>
        <div class="lg:col-span-2">
          {{#each items}}
            {{> accordion-item ../../empty id=id question=question answer=answer}}
          {{/each}}
        </div>
      </section>
    {{/each}}
  </div>

  {{> help-cta}}
</main>

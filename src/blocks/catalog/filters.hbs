{{!-- Панель фильтров на телефоне (сложные-узлы.md п. 4). Лежит прямым потомком body:
      механика панелей у всего сайта одна (п. 2). Выбор внутри панели адрес не трогает —
      применение по кнопке «Ver resultados», и уже оно пишет запись в историю.
      Состояние общее с панелью управления — оно в store, а не в этом узле дерева. --}}
{{#if catalog.hasFilters}}
  <div x-data="overlayPanel('filtros', '(min-width: 1024px)')" x-cloak>
    <div
      x-show="open"
      x-on:click="close()"
      x-transition.opacity.duration.200ms
      class="fixed inset-0 z-30 bg-charcoal/40 lg:hidden"
      aria-hidden="true"
    ></div>

    <div
      x-show="open"
      x-on:keydown.escape.window="open && close()"
      x-transition:enter="transition duration-200 ease-out"
      x-transition:enter-start="translate-y-full"
      x-transition:enter-end="translate-y-0"
      x-transition:leave="transition duration-200 ease-in"
      x-transition:leave-start="translate-y-0"
      x-transition:leave-end="translate-y-full"
      id="filtros-catalogo"
      x-ref="first"
      tabindex="-1"
      role="dialog"
      aria-modal="true"
      aria-labelledby="filtros-titulo"
      class="max-h-sheet fixed inset-x-0 bottom-0 z-30 flex flex-col rounded-t-2xl bg-cream
        lg:hidden"
    >
      <div class="page-container flex h-(--header-h) shrink-0 items-center justify-between">
        <h2 id="filtros-titulo" class="text-h4">{{t "catalog.filters"}}</h2>
        <button
          type="button"
          x-on:click="close()"
          class="-mr-3 flex size-12 items-center justify-center rounded-lg hover:bg-sand-hover"
        >
          <span class="sr-only">{{t "common.close"}}</span>
          {{> icon empty name="x" class="size-6"}}
        </button>
      </div>

      <div class="page-container scrollbar-soft min-h-0 flex-1 overflow-y-auto pb-4">
        {{#if catalog.woodColors.length}}
          <fieldset>
            <legend class="text-small font-medium">{{t "catalog.filterWood"}}</legend>
            <div class="mt-2 flex flex-col">
              {{#each catalog.woodColors}}
                {{> checkbox ../empty value=id xModel="$store.catalog.draftColors"
                    swatch=swatch text=name}}
              {{/each}}
            </div>
          </fieldset>
        {{/if}}

        {{#if catalog.hasStockFilter}}
          <div class="mt-4">
            {{> checkbox empty xModel="$store.catalog.draftInStockOnly"
                label="catalog.filterInStock"}}
          </div>
        {{/if}}
      </div>

      <div class="page-container pb-safe shrink-0 border-t border-line py-3">
        {{!-- Применение и закрытие — одно действие: закрытие снимает запись панели
              из истории, и уже после этого пишется запись нового состояния фильтров --}}
        {{> button empty primary=true sizeMd=true fullWidth=true
            label="catalog.applyFilters" bindLabel="$store.catalog.applyLabel"
            onClick="$store.overlay.close(() => $store.catalog.commitDraft())"}}
      </div>
    </div>
  </div>
{{/if}}

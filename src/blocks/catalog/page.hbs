{{!-- Каталог категории (страницы.md §2). Один блок на все категории: страницы-файлы
      тонкие и о своей категории не знают — её определяет адрес (page-context).
      Строки с подстановкой лежат на этом узле: заранее не известно, сколько товаров
      останется после фильтра, а испанских строк в скриптах не бывает (принцип 27). --}}
<main
  id="contenido"
  class="page-container py-6 lg:py-10"
  data-catalog
  data-t-filter="{{t "catalog.filter"}}"
  data-t-filter-n="{{t "catalog.filterN" n="{n}"}}"
  data-t-apply="{{t "catalog.applyFiltersN" n="{n}"}}"
  data-t-count-one="{{t "catalog.productCountOne"}}"
  data-t-count-many="{{t "catalog.productCount" n="{n}"}}"
>
  {{> breadcrumbs empty items=breadcrumbs.items plain=breadcrumbs.plain}}

  <div class="mt-4 flex flex-col gap-3">
    <h1 class="font-display text-h1 lg:text-h1-lg">{{catalog.category.name}}</h1>
    <p class="text-small text-charcoal/70" data-catalog-count>
      {{#if (eq catalog.products.length 1)}}
        {{t "catalog.productCountOne"}}
      {{else}}
        {{t "catalog.productCount" n=catalog.products.length}}
      {{/if}}
    </p>
    {{#if catalog.category.description}}
      <p class="max-w-prose text-lead text-charcoal/70">{{catalog.category.description}}</p>
    {{/if}}
  </div>

  {{> catalog/toolbar}}
  {{> catalog/grid}}

  {{#if catalog.category.longDescription}}
    {{!-- SEO-текст категории: на телефоне свёрнут — он длинный и живёт для поиска,
          а не для чтения с телефона (страницы.md §2) --}}
    <section
      x-data="{ open: false }"
      class="mt-12 border-t border-line pt-8 lg:mt-16 lg:pt-10"
    >
      <h2 class="font-display text-h3 lg:text-h3-lg">{{catalog.category.name}}</h2>

      {{!-- На телефоне виден первый абзац, остальные раскрываются кнопкой. Обрезкой
            по строкам это не сделать: обрезка живёт на одном узле с текстом, а тут
            их несколько --}}
      <div class="mt-3 flex max-w-prose flex-col gap-3 text-charcoal/70">
        {{#each (paragraphs catalog.category.longDescription)}}
          {{#if @first}}
            <p>{{this}}</p>
          {{else}}
            <p x-show="open" x-cloak class="lg:block!">{{this}}</p>
          {{/if}}
        {{/each}}
      </div>

      <button
        type="button"
        x-on:click="open = !open"
        x-text="open ? '{{t "common.readLess"}}' : '{{t "common.readMore"}}'"
        class="mt-3 text-small font-medium text-clay transition-colors duration-150
          hover:text-clay-hover lg:hidden"
      >{{t "common.readMore"}}</button>
    </section>
  {{/if}}
</main>

{{> catalog/filters}}

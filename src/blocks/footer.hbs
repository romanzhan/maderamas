{{!-- Подвал (компоненты.md 4.8): walnut со светлым текстом, четыре колонки.
      На телефоне они идут одна под другой и всегда раскрыты (решение владельца
      28.08.2026): аккордеон прятал контакты, а места экономил меньше, чем плотные
      строки. --}}
{{!-- Светлая линия сверху: над подвалом может стоять предподвал того же цвета,
      и без неё две тёмные зоны сливаются в одну (27.08.2026) --}}
<footer class="footer-bleed surface-dark mt-auto border-t border-cream/20 bg-walnut text-cream">
  {{!-- Нижний отступ крупнее верхнего: в правом нижнем углу висит кнопка WhatsApp,
        и последняя строка подвала не должна оказаться под ней (сложные-узлы.md п. 7) --}}
  <div class="page-container pt-8 pb-20 lg:pt-12">
    {{!-- Планшет получает свою раскладку, а не растянутую мобильную
          (стандарты-размеров.md п. 2): с 768 колонки раскрыты в два столбца,
          с 1024 — в четыре --}}
    <div class="flex flex-col gap-6 md:grid md:grid-cols-2 md:gap-8 lg:grid-cols-4">
      {{#> footer-column title=(t "footer.tienda")}}
        {{> footer-links empty items=nav.shop}}
      {{/footer-column}}

      {{#> footer-column title=(t "nav.ayuda")}}
        {{> footer-links empty items=nav.helpFooter}}
      {{/footer-column}}

      {{#> footer-column title=(t "footer.legal")}}
        {{> footer-links empty items=nav.legal}}
      {{/footer-column}}

      {{#> footer-column title=(t "nav.contacto")}}
        {{!-- Каждый канал связи — по одному разу (страницы.md, «Навигация сайта»):
              иконка стоит подписью самого канала, отдельного ряда значков рядом нет.
              Тот же список стоит на странице контактов, поэтому он вынесен в компонент --}}
        {{> contact-list onDark=true}}
      {{/footer-column}}
    </div>

    <div
      class="mt-8 flex flex-col gap-6 border-t border-cream/20 pt-6 text-cream/75 text-small
        md:flex-row md:items-center md:justify-between"
    >
      <div class="flex flex-col gap-1">
        <p>{{t "footer.rights" year=year}}</p>
        {{!-- Реквизиты продавца (seo.md п. 8): razón social, CUIT и адрес одной строкой.
              Пока в настройках нет имени или CUIT, строки нет вовсе — половина реквизитов
              выглядела бы как ошибка, а не как соблюдение нормы --}}
        {{#if site.legal.razonSocial}}
          {{#if site.legal.cuit}}
            <p>{{t "footer.requisites" name=site.legal.razonSocial cuit=site.legal.cuit address=site.legal.domicilio}}</p>
          {{/if}}
        {{/if}}
      </div>

      {{!-- Знак «Formulario 960/D» (RG AFIP 4042-E, seo.md п. 8). Картинку отдаёт сама
            ARCA и грузиться она обязана с её сервера: знак показывает текущий статус
            продавца, поэтому своей копии у нас нет и в конвейер картинок он не идёт.
            Размеры проставлены родные — иначе полоса дёргается, пока знак грузится --}}
      {{#if site.legal.dataFiscalUrl}}
        <a
          href="{{site.legal.dataFiscalUrl}}"
          target="_blank"
          rel="noopener"
          class="-m-2 inline-flex shrink-0 rounded-lg p-2 hover:bg-cream/20"
        >
          <img
            src="https://www.afip.gob.ar/images/f960/DATAWEB.jpg"
            alt="{{t "footer.dataFiscal"}}"
            width="239"
            height="327"
            class="w-16"
            loading="lazy"
            decoding="async"
          />
        </a>
      {{/if}}
    </div>
  </div>
</footer>

{{!-- Как регулируется стул (страницы.md §1, блок 6). Разворот зеркалит секцию флагмана
      выше: там фото слева и текст справа, здесь наоборот — два одинаковых разворота
      подряд читались бы одним блоком (решение владельца 27.08.2026).
      Секция говорит про одну модель, а не про всю линейку: регулировка есть у трёх
      стульев из четырёх, но показать механизм можно только на одном стуле — иначе
      кадры читаются как три разных товара.
      Справа одно место, в котором листаются кадры регулировки: инфографику для них
      готовит владелец, поэтому пока стоят заглушки той же геометрии.
      Якорь — цель вторичной кнопки героя. --}}
<section id="como-crece" class="page-container py-12 lg:py-20">
  {{!-- На телефоне порядок такой: заголовок → кадры → тексты (решение владельца
        28.08.2026), поэтому у элементов проставлен порядок.
        На компьютере заголовок и тексты — одна колонка, и она центрируется относительно
        кадра целиком (замечание владельца 29.08.2026): раньше половина сетки доставалась
        заголовку, половина текстам, и пара выходила тяжёлой снизу.
        Обёртка вокруг них на телефоне не создаёт коробки (`contents`) — иначе кадр
        не смог бы встать между заголовком и текстами; на компьютере она становится
        обычным блоком, и центрировать колонку есть чем. --}}
  <div class="flex flex-col gap-6 lg:grid lg:grid-cols-2 lg:items-center lg:gap-x-16">
    <div class="contents lg:block">
      <h2 class="order-1 font-display text-h2 lg:text-h2-lg">{{t "home.stepsTitle"}}</h2>

      <div class="order-3 flex flex-col items-start gap-6 lg:mt-8">
        <p class="max-w-prose text-lead text-charcoal/70">{{t "home.stepsText"}}</p>

        <ul class="flex w-full flex-col gap-6">
          <li>
            {{> feature-item empty inline=true icon="move-vertical" title="home.step1Title"
                text="home.step1Text"}}
          </li>
          <li>
            {{> feature-item empty inline=true icon="utensils" title="home.step2Title"
                text="home.step2Text"}}
          </li>
          <li>
            {{> feature-item empty inline=true icon="backpack" title="home.step3Title"
                text="home.step3Text"}}
          </li>
        </ul>

        {{!-- На телефоне кнопка во всю ширину (решение владельца 28.08.2026), на широком
              экране — по своей подписи: колонка там половина сетки.
              Отступ сверху больше обычного: кнопка не пункт списка, и вплотную к нему
              читалась бы четвёртым (замечание владельца 29.08.2026) --}}
        <div class="mt-2 w-full lg:mt-4 lg:w-auto">
          {{#with home.flagship}}
            {{> button ../empty secondary=true sizeLg=true fullWidth=true label="home.stepsCta"
                href=(productUrl this)}}
          {{/with}}
        </div>
      </div>
    </div>

    <div class="order-2 min-w-0">
      {{> frame-carousel empty frames=home.adjustFrames alt=(t "home.stepsFrameAlt")
          sizes="(min-width: 1024px) 50vw, 100vw"}}
    </div>
  </div>
</section>

{{!-- Живые кадры (страницы.md §1, блок 9). Своя лента, а не встроенная лента Instagram:
      чужой скрипт тянет согласие на куки, тормозит страницу и ломается при смене
      правил Meta. Посты приходят из data/instagram.json, плитка — компонент 7.9:
      фото, карусель или рилс. --}}
{{#> carousel sectionClass="bg-sand py-12 lg:py-20" title=(t "home.instagramTitle")
    linkHref=links.instagram linkLabel="home.instagramCta" linkExternal=true onSand=true}}
  {{#each home.instagram}}
    <div class="swiper-slide">
      {{> instagram-post ../empty post=this}}
    </div>
  {{/each}}
{{/carousel}}

{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": "WordPress/WordPress#7.0.2",
	"phpVersion": "8.3",
	"plugins": [
		"https://downloads.wordpress.org/plugin/woocommerce.10.9.4.zip",
		"https://downloads.wordpress.org/plugin/woocommerce-mercadopago.8.9.0.zip"
	],
	"mappings": {
		"wp-content/themes/maderamas": "./wp-content/themes/maderamas",
		"wp-content/mu-plugins": "./wp-content/mu-plugins"
	},
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": true,
		"SCRIPT_DEBUG": true,
		"WP_ENVIRONMENT_TYPE": "local",
		"WP_DEFAULT_THEME": "maderamas"
	},
	"env": {
		"tests": {
			"config": {
				"WP_DEBUG": true,
				"WP_ENVIRONMENT_TYPE": "local"
			}
		}
	}
}
